						<p class="text-xs uppercase text-primary-300 font-semibold mb-2">Products</p>
						<ul>
							<li class="mb-1">
								<a href="/admin/categories" class="flex items-center p-2 rounded hover:bg-blue-700 dark:hover:bg-gray-700 transition-colors duration-300 {% if current_page == 'categories' %}bg-blue-700{% endif %}">
									<i class="fas fa-tags mr-3"></i>
