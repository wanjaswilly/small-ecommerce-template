		<div class="grid grid-cols-4 md:grid-cols-8 gap-1 sm:gap-4">
			{% for brand in brands|slice(0,8) %}
			<div class="brand-card group">
				<a href="/brand/{{brand.slug}}" class="flex flex-col items-center p-4">
					<div class="justify-center items-center mb-3">
						{% if brand.logo %}
						<img src="{{ brand.logo }}" alt="{{ brand.name }}" class="brand-logo">
						{% else %}
						<div class="brand-placeholder bg-gray-100 text-gray-400 rounded-lg">
							<i class="fas fa-store text-2xl"></i>
						</div>
						{% endif %}
					</div>
					<span class="brand-name">{{ brand.name }}</span>
					<span class="brand-products text-xs text-gray-500 mt-1">{{ brand.product_count }}
						products</span>
				</a>
			</div>
			{% else %}
			{% for brand_name in ['Samsung', 'Apple', 'Tecno', 'Adidas', 'Nike', 'LG', 'HP', 'Lenovo'] %}
			<div class="brand-card group">
				<a href="#" class="flex flex-col items-center p-2 sm:p-4">
