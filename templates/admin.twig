								<a href="/admin/customers" class="flex items-center p-2 rounded hover:bg-blue-700 dark:hover:bg-gray-700 transition-colors duration-300 {% if current_page == 'customers' %}bg-blue-700{% endif %}">
									<i class="fas fa-users mr-3"></i>
									<span>Customers</span>
