{% extends "admin.twig" %}

{% block content %}
	<div class="min-h-screen bg-gray-50 py-6">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="mb-6">
				<a href="/admin/contact-messages" class="inline-flex items-center text-blue-600 hover:text-blue-500 mb-4">
					<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewbox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
					</svg>
					Back to Contact Messages
				</a>
				<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
					<div>
						<h1 class="text-2xl font-bold text-gray-900">Message From
							{{  message.fullname }}</h1>
						<p class="mt-2 text-gray-600">Sent on
							{{  message.created_at|date('F d, Y \\a\\t g:i A') }}</p>
					</div>
					<div class="mt-4 sm:mt-0">
						{% if message.repliedat %}
							<span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
								Replied
							</span>
						{% else %}
							<span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200">
								Not Replied
							</span>
						{% endif %}
					</div>
				</div>
			</div>

			<div
				class="space-y-6">
				<!-- Message details -->
				<div class="bg-white shadow rounded-lg p-6">
					<h2 class="text-lg font-medium text-gray-900 mb-4">Message Details</h2>
					<div class="space-y-4">
						<div class="flex items-center">
							<div class="">
								<p class="text-sm font-medium text-gray-900">{{ message.message }}</p>
							</div>
						</div>
					</div>
				</div>

				<!-- Reply to message if not replied -->
				{% if message.repliedat %}

					<div class="bg-white shadow rounded-lg p-6">
						<h2 class="text-sm font-medium text-gray-900 mb-4">Replied on
							{{  message.repliedat|date('F d, Y \\a\\t g:i A') }}
							by
							{{ message.repliedby.first_name }} {{ message.repliedby.last_name }}</h2>
						<div class="space-y-4">
							<div class="bg-white shadow rounded-lg p-6">
								<h2 class="text-lg font-medium text-gray-900 mb-4">Reply Details</h2>
								<div class="space-y-4">
									<div class="flex items-center">
										<div class="">
											<p class="text-sm font-medium text-gray-900">{{ message.reply }}</p>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				{% else %}
					<div class="bg-white shadow rounded-lg p-6">
						<h2 class="text-lg font-medium text-gray-900 mb-4">Reply Message</h2>
						<div class="space-y-4">
							<form action="/admin/contact-message/{{message.id}}/reply" method="POST">
								<div class="space-y-6">
									{{ csrf_field() | raw }}

									<div>
										<textarea name="reply" rows="3" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500" placeholder="Your reply here..."></textarea>
									</div>
								</div>

								<!-- Submit Buttons -->
								<div class="mt-8 flex justify-end space-x-4">
									<a href="/admin/contact-messages" class="px-6 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors duration-300">
										Cancel
									</a>
									<button type="submit" class="bg-primary-600 hover:bg-primary-700 text-white px-6 py-2 rounded-lg transition-colors duration-300 flex items-center">
										<i class="fas fa-save mr-2"></i>
										Save Reply
									</button>
								</div>
							</form>
						</div>
					</div>
				{% endif %}
			</div>
		</div>
	</div>
{% endblock %}
