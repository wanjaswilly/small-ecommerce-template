	// Hero Carousel Functionality
	document.addEventListener('DOMContentLoaded', function () { // Desktop carousel
		const heroSlides = document.querySelectorAll('.hero-slide');
		const heroCaptions = document.querySelectorAll('.hero-caption');
		const prevButton = document.querySelector('.hero-prev');
		const nextButton = document.querySelector('.hero-next');

		// Mobile carousel
		const mobileSlides = document.querySelectorAll('.hero-slide-mobile');
		const mobileIndicators = document.querySelectorAll('.hero-indicator');

		let currentSlide = 0;
		const totalSlides = heroSlides.length;

		// Auto-rotate slides every 5 seconds
		let slideInterval = setInterval(nextSlide, 5000);

		function showSlide(index) { // Hide all slides and captions
			heroSlides.forEach(slide => slide.classList.remove('active'));
			heroCaptions.forEach(caption => caption.classList.remove('active'));
			mobileSlides.forEach(slide => slide.classList.remove('active'));
			mobileIndicators.forEach(indicator => {
				indicator.classList.remove('bg-opacity-100');
				indicator.classList.add('bg-opacity-30');
			});

			// Show current slide and caption
			heroSlides[index].classList.add('active');
			heroCaptions[index].classList.add('active');
			mobileSlides[index].classList.add('active');
			mobileIndicators[index].classList.remove('bg-opacity-30');
			mobileIndicators[index].classList.add('bg-opacity-100');

			currentSlide = index;

			// Reset auto-rotate timer
			clearInterval(slideInterval);
			slideInterval = setInterval(nextSlide, 5000);
		}

		function nextSlide() {
			currentSlide = (currentSlide + 1) % totalSlides;
			showSlide(currentSlide);
		}

		function prevSlide() {
			currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
			showSlide(currentSlide);
		}

		// Event listeners for desktop
		if (prevButton && nextButton) {
			prevButton.addEventListener('click', prevSlide);
			nextButton.addEventListener('click', nextSlide);
		}

		// Event listeners for mobile indicators
		mobileIndicators.forEach((indicator, index) => {
			indicator.addEventListener('click', () => {
				showSlide(index);
			});
		});

		// Pause auto-rotate on hover
		const heroCarousel = document.querySelector('.hero-carousel');
		if (heroCarousel) {
			heroCarousel.addEventListener('mouseenter', () => {
				clearInterval(slideInterval);
			});

			heroCarousel.addEventListener('mouseleave', () => {
				slideInterval = setInterval(nextSlide, 5000);
			});
		}

		// Flash Sale Countdown Timer
		function updateCountdown() {
			const countdownElement = document.getElementById('countdown');
			if (!countdownElement)
				return;



			// Set end time (2 hours from now)
			const endTime = new Date();
			endTime.setHours(endTime.getHours() + 2);
			endTime.setMinutes(endTime.getMinutes() + 15);
			endTime.setSeconds(endTime.getSeconds() + 38);

			function update() {
				const now = new Date();
				const diff = endTime - now;

				if (diff <= 0) {
					countdownElement.textContent = "00:00:00";
					return;
				}

				const hours = Math.floor(diff / (1000 * 60 * 60));
				const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
				const seconds = Math.floor((diff % (1000 * 60)) / 1000);

				countdownElement.textContent = `${hours.toString().padStart(2, '0')
					}:${minutes.toString().padStart(2, '0')
					}:${seconds.toString().padStart(2, '0')
					}`;
			}

			update();
			setInterval(update, 1000);
		}

		updateCountdown();
	});
</script>
