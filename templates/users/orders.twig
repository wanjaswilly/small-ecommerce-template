{% extends 'layout.twig' %}

{% block title %}My Orders - {{ parent() }}{% endblock %}

{% block content %}
<div class="min-h-screen bg-gray-50 dark:bg-gray-900 py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="flex items-center justify-between mb-8">
            <div>
                <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">My Orders</h1>
                <p class="text-gray-600 dark:text-gray-400">View your order history and track deliveries</p>
            </div>
            <a href="/user/account/dashboard" class="inline-flex items-center px-4 py-2 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                <i class="fas fa-arrow-left mr-2"></i>
                Back to Dashboard
            </a>
        </div>

        <!-- Orders List -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm">
            {% if orders and orders|length > 0 %}
            <div class="divide-y divide-gray-200 dark:divide-gray-700">
                {% for order in orders %}
                <div class="p-6 hover:bg-gray-50 dark:hover:bg-gray-750 transition-colors">
                    <div class="flex items-center justify-between mb-4">
                        <div>
                            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">{{ order.order_number }}</h3>
                            <p class="text-sm text-gray-600 dark:text-gray-400">
                                Placed on {{ order.created_at|date("F j, Y \\a\\t g:i A") }}
                            </p>
                        </div>
                        <div class="text-right">
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium 
                                {% if order.status == 'delivered' %}bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300
                                {% elseif order.status == 'processing' %}bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300
                                {% elseif order.status == 'shipped' %}bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-300
                                {% elseif order.status == 'pending' %}bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-300
                                {% elseif order.status == 'cancelled' %}bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-300
                                {% else %}bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300{% endif %}">
                                {{ order.status|title }}
                            </span>
                            <p class="text-lg font-bold text-gray-900 dark:text-white mt-1">
                                KSh {{ order.total_amount|number_format(2) }}
                            </p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4 text-sm">
                        <div>
                            <span class="text-gray-600 dark:text-gray-400">Payment:</span>
                            <span class="text-gray-900 dark:text-white ml-2 capitalize">{{ order.payment_method|replace({'_': ' '}) }}</span>
                        </div>
                        <div>
                            <span class="text-gray-600 dark:text-gray-400">Payment Status:</span>
                            <span class="{% if order.payment_status == 'paid' %}text-green-600 dark:text-green-400{% else %}text-yellow-600 dark:text-yellow-400{% endif %} ml-2 capitalize">
                                {{ order.payment_status }}
                            </span>
                        </div>
                        <div>
                            <span class="text-gray-600 dark:text-gray-400">Items:</span>
                            <span class="text-gray-900 dark:text-white ml-2">
                                {% set item_count = 0 %}
                                {% for item in order.items %}
                                    {% set item_count = item_count + item.quantity %}
                                {% endfor %}
                                {{ item_count }} item(s)
                            </span>
                        </div>
                    </div>

                    <div class="flex items-center justify-between">
                        <div class="flex space-x-3">
                            <a href="/user/account/orders/{{ order.id }}" 
                               class="inline-flex items-center px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-lg transition-colors text-sm">
                                <i class="fas fa-eye mr-2"></i>
                                View Details
                            </a>
                            {% if order.status == 'pending' %}
                            <form action="/user/account/orders/{{ order.id }}/cancel" method="POST" class="inline">
                                <input type="hidden" name="_token" value="{{ session.csrf_token }}">
                                <button type="submit" 
                                        onclick="return confirm('Are you sure you want to cancel this order?')"
                                        class="inline-flex items-center px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg transition-colors text-sm">
                                    <i class="fas fa-times mr-2"></i>
                                    Cancel Order
                                </button>
                            </form>
                            {% endif %}
                        </div>
                        {% if order.status == 'shipped' %}
                        <a href="/track-order/{{ order.id }}" 
                           class="inline-flex items-center text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300 text-sm">
                            <i class="fas fa-truck mr-2"></i>
                            Track Order
                        </a>
                        {% endif %}
                    </div>
                </div>
                {% endfor %}
            </div>
            {% else %}
            <!-- Empty State -->
            <div class="text-center py-12">
                <i class="fas fa-shopping-bag text-gray-300 dark:text-gray-600 text-5xl mb-4"></i>
                <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2">No orders yet</h3>
                <p class="text-gray-600 dark:text-gray-400 mb-6">You haven't placed any orders with us yet.</p>
                <a href="/electronics" class="inline-flex items-center px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white rounded-lg transition-colors">
                    <i class="fas fa-shopping-cart mr-2"></i>
                    Start Shopping
                </a>
            </div>
            {% endif %}
        </div>

        <!-- Pagination (if needed) -->
        {% if orders and orders|length >= 10 %}
        <div class="mt-6 flex justify-center">
            <nav class="flex items-center space-x-2">
                <button class="px-3 py-2 rounded-lg bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700">
                    Previous
                </button>
                <button class="px-3 py-2 rounded-lg bg-primary-600 text-white">1</button>
                <button class="px-3 py-2 rounded-lg bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700">
                    2
                </button>
                <button class="px-3 py-2 rounded-lg bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700">
                    Next
                </button>
            </nav>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}