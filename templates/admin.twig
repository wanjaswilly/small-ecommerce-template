		<meta property="og:description" content="{% block og_description %}Admin dashboard for managing Small Ecommerce inventory and operations.{% endblock %}"/>
		<meta property="og:type" content="website"/>
		<meta property="og:url" content="{{ app_url|default('https://smallecommerce.co.ke') }}"/>
		<meta
		property="og:image" content="{{ app_url|default('https://smallecommerce.co.ke') }}/assets/og-image.jpg"/>

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image"/>
		<meta name="twitter:title" content="{% block twitter_title %}Small Ecommerce Admin{% endblock %}"/>
		<meta name="twitter:description" content="{% block twitter_description %}Admin dashboard for Small Ecommerce.{% endblock %}"/>
		<meta
		name="twitter:image" content="{{ app_url|default('https://smallecommerce.co.ke') }}/assets/twitter-card.jpg"/>

		<!-- Google Font -->
		<link
		href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

		<!-- Font Awesome -->
		<link
		rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

		<!-- Tailwind CSS -->
