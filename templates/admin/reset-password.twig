{% extends "admin.twig" %}

{% block title %}Reset User Password
{% endblock %}

{% block page_title %}Reset User Password
{% endblock %}

{% block page_description %}Reset user password
{% endblock %}

{% block page_breadcrumb %}
	<span class="mx-2">/</span>
	<span class="text-gray-800 dark:text-gray-200">Reset User Password</span>
{% endblock %}

{% block content %}
	<div
		class="px-4 sm:px-6 lg:px-8 py-8">
		<!-- Header -->
		<div class=" max-w-4xl mb-8">
			<a href="/admin/riders" class="inline-flex items-center text-blue-600 hover:text-blue-500 mb-4">
				<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewbox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
				</svg>
				Back to Dashboard
			</a>
			<h1 class="text-2xl font-semibold text-gray-900">Reset User Password</h1>
		</div>
		<div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 max-w-4xl">
			<form action="/admin/reset-password" method="POST">
				<div class="space-y-6">
					{{ csrf_field() | raw }}

					<div>
						<label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">User's Email *</label>
						<input type="email" name="email" required class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500" placeholder="email@example.com">
					</div>

				</div>

				<!-- Submit Buttons -->
				<div class="mt-8 flex justify-end space-x-4">
					<a href="/admin" class="px-6 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors duration-300">
						Cancel
					</a>
					<button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg transition-colors duration-300 flex items-center">
						<i class="fas fa-save mr-2"></i>
						Reset Password
					</button>
				</div>
			</form>
		</div>
	</div>
{% endblock %}
