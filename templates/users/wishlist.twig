{# user/favourites.twig #}
{% extends 'layout.twig' %}

{% block title %}My Favourites {% endblock %}

{% block content %}
<div class="min-h-screen bg-gray-50 py-6">
    <div class="container mx-auto px-4">
        <!-- Header -->
        <div class="mb-8">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-2xl font-bold text-gray-800">My Favourites</h1>
                    <p class="text-gray-600 mt-1">Your saved items</p>
                </div>
                <div class="flex items-center space-x-4">
                    <span class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm font-medium">
                        {{ user.favourites|length }} item{{ user.favourites|length != 1 ? 's' : '' }}
                    </span>
                    <a href="/user/account/dashboard" class="text-blue-600 hover:text-blue-800">
                        ← Dashboard
                    </a>
                </div>
            </div>
        </div>

        {% if session.success %}
            <div class="mb-6 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded">
                {{ session.success }}
            </div>
        {% endif %}

        {% if user.favourites|length > 0 %}
            <!-- Favourites Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                {% for favourite in user.favourites %}
                <div class="bg-white rounded-lg shadow overflow-hidden hover:shadow-lg transition">
                    <!-- Product Image -->
                    <div class="relative">
                        <a href="/products/{{ favourite.product.slug }}">
                            <div class="aspect-square bg-gray-100">
                                {% if favourite.product.images %}
                                    <img src="{{ favourite.product.images[0]}}" 
                                         alt="{{ favourite.product.name }}"
                                         class="w-full h-full object-cover hover:scale-105 transition-transform duration-300">
                                {% else %}
                                    <div class="w-full h-full flex items-center justify-center">
                                        <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                        </svg>
                                    </div>
                                {% endif %}
                            </div>
                        </a>
                        
                        <!-- Remove Button -->
                        <form method="POST" action="/user/account/wishlist/remove/{{ favourite.id }}" 
                              class="absolute top-3 right-3">
                              {{ csrf_field() |raw }}
                            <button type="submit" 
                                    class="w-8 h-8 bg-white rounded-full shadow flex items-center justify-center 
                                           hover:bg-red-50 hover:text-red-600 transition"
                                    onclick="return confirm('Remove from favourites?')">
                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"/>
                                </svg>
                            </button>
                        </form>

                        <!-- Sale Badge -->
                        {% if favourite.product.on_offer and favourite.product.offer_price %}
                        <div class="absolute top-3 left-3">
                            <span class="px-2 py-1 bg-red-600 text-white text-xs font-semibold rounded">
                                SALE
                            </span>
                        </div>
                        {% endif %}
                    </div>

                    <!-- Product Info -->
                    <div class="p-4">
                        <div class="mb-2">
                            <a href="/products/{{ favourite.product.slug }}" 
                               class="font-medium text-gray-800 hover:text-blue-600 transition line-clamp-1">
                                {{ favourite.product.name }}
                            </a>
                            <p class="text-sm text-gray-600 mt-1 line-clamp-2">
                                {{ favourite.product.short_description }}
                            </p>
                        </div>

                        <!-- Price -->
                        <div class="flex items-center justify-between">
                            <div>
                                {% if favourite.product.on_offer and favourite.product.offer_price %}
                                    <span class="font-bold text-gray-800">
                                        KES {{ favourite.product.offer_price|number_format(2) }}
                                    </span>
                                    <span class="ml-2 text-sm text-gray-500 line-through">
                                        KES {{ favourite.product.price|number_format(2) }}
                                    </span>
                                {% else %}
                                    <span class="font-bold text-gray-800">
                                        KES {{ favourite.product.price|number_format(2) }}
                                    </span>
                                {% endif %}
                            </div>

                            <!-- Stock Status -->
                            {% if favourite.product.stock_quantity > 0 %}
                                <span class="text-xs px-2 py-1 bg-green-100 text-green-800 rounded">
                                    In Stock
                                </span>
                            {% else %}
                                <span class="text-xs px-2 py-1 bg-red-100 text-red-800 rounded">
                                    Out of Stock
                                </span>
                            {% endif %}
                        </div>

                        <!-- Actions -->
                        <div class="mt-4 space-y-2">
                                <button type="submit" 
                                        class="w-full py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition add-to-cart" data-product-id="{{ favourite.product.id }}" data-product-name="{{ favourite.product.name }}" >
                                    Add to Cart
                                </button>
                            
                            <a href="/products/{{ favourite.product.slug }}"
                               class="block py-2 text-center border border-gray-300 text-gray-700 rounded hover:bg-gray-50 transition">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>

            <!-- Clear All Button -->
            {% if user.favourites|length > 1 %}
            <div class="mt-8 text-center">
                <form method="POST" action="/user/account/wishlist/clear-all" onsubmit="return confirm('Remove all favourites?')">
                              {{ csrf_field() |raw }}
                    <button type="submit" 
                            class="px-6 py-2 border border-red-300 text-red-600 rounded hover:bg-red-50 transition">
                        Clear All Favourites
                    </button>
                </form>
            </div>
            {% endif %}
        {% else %}
            <!-- Empty State -->
            <div class="bg-white rounded-lg shadow p-8 text-center">
                <div class="max-w-md mx-auto">
                    <svg class="mx-auto h-16 w-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                    </svg>
                    <h3 class="mt-4 text-lg font-medium text-gray-900">No favourites yet</h3>
                    <p class="mt-2 text-gray-600">
                        Save products you love by clicking the heart icon.
                    </p>
                    <div class="mt-6">
                        <a href="/products" 
                           class="inline-flex items-center px-6 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition">
                            Browse Products
                        </a>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</div>

<style>
/* Line clamp utility */
.line-clamp-1 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
}

.line-clamp-2 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
}

/* Hover effects */
.hover\:scale-105:hover {
    transform: scale(1.05);
}

/* Transition utilities */
.transition {
    transition: all 0.2s ease-in-out;
}

.transition-transform {
    transition-property: transform;
}
</style>
{% endblock %}