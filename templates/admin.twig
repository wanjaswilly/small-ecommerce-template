						<div class="w-8 h-8 bg-white rounded-full flex items-center justify-center">
							<span class="text-primary-800 font-bold text-sm">CE</span>
						</div>
						<span class="text-xl font-bold">Small Ecommerce</span>
					</a>
					<button id="closeSidebar" class="md:hidden text-white">
						<i class="fas fa-times"></i>
					</button>
				</div>

				<nav
					class="p-4 overflow-y-auto h-[calc(100%-64px)]">
					<!-- Main Navigation -->
					<div class="mb-6">
						<p class="text-xs uppercase text-primary-300 font-semibold mb-2">Main</p>
						<ul>
							<li class="mb-1">
								<a href="/admin" class="flex items-center p-2 rounded hover:bg-blue-700 dark:hover:bg-gray-700 transition-colors duration-300 {% if current_page == 'dashboard' %}bg-blue-700{% endif %}">
									<i class="fas fa-tachometer-alt mr-3"></i>
									<span>Dashboard</span>
								</a>
							</li>
							<li class="mb-1">
								<a href="/admin/orders" class="flex items-center p-2 rounded hover:bg-blue-700 dark:hover:bg-gray-700 transition-colors duration-300 {% if current_page == 'orders' %}bg-blue-700{% endif %}">
									<i class="fas fa-shopping-cart mr-3"></i>
									<span>Orders</span>
									{# <span class="ml-auto bg-yellow-500 text-white text-xs px-2 py-1 rounded-full">12</span> #}
								</a>
							</li>
							<li class="mb-1">
								<a href="/admin/sales" class="flex items-center p-2 rounded hover:bg-blue-700 dark:hover:bg-gray-700 transition-colors duration-300 {% if current_page == 'orders' %}bg-blue-700{% endif %}">
									<i class="fas fa-shopping-cart mr-3"></i>
