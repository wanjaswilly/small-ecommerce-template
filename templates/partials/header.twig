<!-- Top Announcement Bar -->
<div class="bg-orange-500 text-white py-2 px-4 text-center text-[10px] sm:text-sm font-bold">
	<a href="/sale/corey-black-friday">
		🎉 Small Ecom BLACK FRIDAY: Up to 13% OFF! Shop Now →
	</a>
</div>

<!-- Top Bar -->
<header class="bg-white border-b">
	<div
		class="container mx-auto px-4">
		<!-- Desktop Top Bar -->
		<div
			class="hidden md:flex items-center justify-between py-3">
			<!-- Logo -->
			<a href="/" class="text-2xl font-black text-orange-500">
				Small Ecom<span class="text-gray-800">®</span>
			</a>

			<!-- Search Bar -->
			<div class="flex-1 max-w-2xl mx-8">
				<div class="relative">
					<form action="/search" method="get">
						<input type="text" name="search" placeholder="Search products, brands and categories" class="w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-orange-500">
						<button type="submit" class="absolute right-0 top-0 bottom-0 bg-orange-500 text-white px-4 rounded-r font-bold hover:bg-orange-600">
							<i class="fas fa-search"></i>
						</button>
					</form>
				</div>
			</div>

			<!-- Account, Help, Cart -->
			<div class="flex items-center space-x-6">
				<a href="/user/account" class="flex flex-col items-center text-gray-700 hover:text-orange-500">
					<i class="fas fa-user text-lg"></i>
					<span class="text-xs">Account</span>
				</a>
				<a href="/cart" class="flex flex-col items-center text-gray-700 hover:text-orange-500 relative">
					<i class="fas fa-shopping-cart text-lg"></i>
					<span class="text-xs">Cart</span>
					<span class="absolute -top-1 -right-1 bg-orange-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center cart_total_items"></span>
				</a>
				{% if session.user_id %}
					<form action="/logout" method="post">
						{{ csrf_field() | raw }}
						<button type="submit" class="flex flex-col items-center text-gray-700 hover:text-orange-500 relative">
							<i class="fas fa-power-off text-lg"></i>
							<span class="text-xs">Logout</span>
						</button>
					</form>
				{% endif %}

			</div>
		</div>

		<!-- Mobile Top Bar -->
		<div class="md:hidden flex items-center justify-between py-2">
			<div class="space-x-3">
				<button class="mobile-menu-btn p-2">
					<i class="fas fa-bars text-gray-700"></i>
				</button>
				<a href="/" class="text-xl font-black text-orange-500">
					Small Ecom<span class="text-gray-800">®</span>
				</a>
			</div>
			<div class="relative flex space-x-4">
				<a href="/user/account">
					<i class="fas fa-user text-gray-700"></i>
					<span class="absolute -top-1 -right-1 bg-orange-500 text-white text-xs rounded-full w-4 h-4 flex items-center justify-center">0</span>
				</a>
				<a href="/cart">
					<i class="fas fa-shopping-cart text-gray-700"></i>
					<span class="absolute -top-1 -right-1 bg-orange-500 text-white text-xs rounded-full w-4 h-4 flex items-center justify-center cart_total_items">0</span>
				</a>
			</div>
		</div>
	</div>
</header>

<!-- Services Bar -->
<div class="hidden md:flex bg-gray-100 border-b">
	<div class="container mx-auto px-4 py-2">
		<div class="flex items-center justify-center space-x-8 text-sm">
			<span class="flex items-center text-gray-700">
				<i class="fas fa-product mr-1 text-orange-500"></i>
				GENUINE PRODUCTS
			</span>
			<span class="flex items-center text-gray-700">
				<i class="fas fa-store mr-1 text-orange-500"></i>
				UPTO 24 MONTHS WARRANTY
			</span>
			<span class="flex items-center text-gray-700">
				<i class="fas fa-utensils mr-1 text-orange-500"></i>
				SECURE PAYMENT
			</span>
			<span class="flex items-center text-gray-700">
				<i class="fas fa-money-bill-wave mr-1 text-orange-500"></i>
				PAY ON DELIVERY
			</span>
			<span class="flex items-center text-gray-700">
				<i class="fas fa-globe mr-1 text-orange-500"></i>
				Small Ecom GLOBAL
			</span>
		</div>
	</div>
</div>

<!-- Navigation Menu -->
<nav class="bg-gray-800 text-white">
	<div
		class="container mx-auto px-4">
		<!-- Desktop Navigation -->
		<div class="hidden md:flex items-center space-x-8 py-3">
			<a href="/categories">
				<button class="flex items-center space-x-2 bg-orange-500 px-4 py-2 rounded-lg font-bold">
					<i class="fas fa-bars"></i>
					<span>All Categories</span>
				</button>
			</a>

			<div class="flex space-x-6 text-sm font-medium">
				<a href="/sales" class="hover:text-orange-300 transition duration-200">Flash Sales</a>
				<a href="/products" class="hover:text-orange-300 transition duration-200">All Products</a>
				<a href="/category/electronics" class="hover:text-orange-300 transition duration-200">Electronics</a>
				<a href="/category/car-parts" class="hover:text-orange-300 transition duration-200">Car Parts</a>
				<a href="/category/smartphones" class="hover:text-orange-300 transition duration-200">Automotive & Motorbike</a>
				<a href="/category/smartphones" class="hover:text-orange-300 transition duration-200">Smartphones</a>
			</div>
		</div>

		<!-- Mobile Navigation -->
		<div class="md:hidden flex items-center justify-between py-3">
			<div class="flex space-x-4  text-xs font-medium flex-1 ml-4">
				<a href="/products" class="whitespace-nowrap hover:text-orange-300 transition duration-200">All Products</a>
				<a href="/category/electronics" class="whitespace-nowrap hover:text-orange-300 transition duration-200">Electronics</a>
				<a href="/category/smartphones" class="hover:text-orange-300 transition duration-200">Smartphones</a>
			</div>
		</div>
	</div>
</nav>

<!-- Mobile Menu Overlay -->
<div class="mobile-menu-overlay fixed inset-0 bg-black bg-opacity-50 z-50 hidden">
	<div class="fixed top-0 left-0 w-64 h-full bg-orange-500 text-white shadow-lg transform -translate-x-full transition-transform duration-300 ease-in-out mobile-menu">
		<div class="p-4 border-b">
			<div class="flex items-center justify-between ">
				<span class="text-lg font-bold hover:text-black">Menu</span>
				<button class="mobile-menu-close p-2 rounded-lg hover:bg-gray-100">
					<i class="fas fa-times text-xl"></i>
				</button>
			</div>
		</div>
		<div class="p-4 space-y-4">
			<a href="/" class="block py-2 px-4 hover:bg-orange-50 hover:text-black  rounded-lg">Home</a>
			<a href="/products" class="block py-2 px-4 hover:bg-orange-50 hover:text-black  rounded-lg">All Products</a>
			<a href="/category/electronics" class="block py-2 px-4 hover:bg-orange-50 hover:text-black  rounded-lg">Electronics</a>
			<a href="/category/car-parts" class="block py-2 px-4 hover:bg-orange-50 hover:text-black rounded-lg">Automotive</a>
			<a href="/user/account" class="block py-2 px-4 hover:bg-orange-50 hover:text-black rounded-lg">My Account</a>
			<a href="/help" class="block py-2 px-4 hover:bg-orange-50 hover:text-black rounded-lg">Help Center</a>
		</div>
	</div>
</div>

<!-- MOBILE FIXED FOOTER MENU -->
<div class="md:hidden fixed bottom-0 left-0 right-0 z-40 bg-white border-t shadow-lg">
	<div
		class="grid grid-cols-4 text-center text-xs text-gray-700">

		<!-- SHOP -->
		<a href="/" class="py-3 flex flex-col items-center justify-center hover:text-[#842454]">
			<i class="fa fa-store text-lg"></i>
			<span class="mt-1">Home</span>
		</a>

		<!-- CATEGORIES -->
		<a href="/categories" class="py-3 flex flex-col items-center justify-center hover:text-[#842454]">
			<i class="fa fa-list text-lg"></i>
			<span class="mt-1">Categories</span>
		</a>

		<!-- CART -->
		<a href="/cart" class="relative py-3 flex flex-col items-center justify-center hover:text-[#842454]">
			<i class="fa fa-shopping-cart text-lg"></i>
			<span class="absolute top-1 right-6 bg-red-500 text-white text-xs rounded-full h-5 w-5 flex items-center justify-center cart_total_items" data-cart-count></span>
			<span class="mt-1">Cart</span>
		</a>

		<!-- ACCOUNT -->
		<a href="/user/account" class="py-3 flex flex-col items-center justify-center hover:text-[#842454]">
			<i class="fa fa-user text-lg"></i>
			<span class="mt-1">Account</span>
		</a>

	</div>
</div>
