{% extends "layout.twig" %}

{% block title %}
	{{ product.name }}
	- Small Ecommerce
{% endblock %}
{% block description %}
	{{ product.description|slice(0, 160) }}
{% endblock %}
{% block og_title %}
	{{ product.name }}
	- Small Ecommerce
{% endblock %}
{% block og_description %}
	{{ product.description|slice(0, 160) }}
{% endblock %}
{% block og_image %}
	{{ product.images[0] }}
{% endblock %}
{% block twitter_title %}
	{{ product.name }}
	- Small Ecommerce
{% endblock %}
{% block twitter_description %}
	{{ product.description|slice(0, 160) }}
{% endblock %}
{% block twitter_image %}
	{{ product.images[0] }}
{% endblock %}
{% block canonical %}
	{{ app_url }}/products/{{ product.slug }}
{% endblock %}

{% block structured_data %}
	{
											  "@context": "https://schema.org/",
											  "@type": "Product",
											  "name": "{{ product.name }}",
											  "image": "{{ product.images[0] }}",
											  "description": "{{ product.description }}",
											  "sku": "{{ product.sku }}",
											  "brand": {
											    "@type": "Brand",
											    "name": "{{ product.attributes.brand ?? 'Small Ecommerce' }}"
											  },
											  "offers": {
											    "@type": "Offer",
											    "url": "{{ app_url }}/products/{{ product.slug }}",
											    "priceCurrency": "KES",
											    "price": "{{ product.price }}",
											    "availability": "https://schema.org/InStock",
											    "seller": {
											      "@type": "Organization",
											      "name": "Small Ecommerce"
											    }
											  }
											}
{% endblock %}

{% block content %}
	<section class="max-w-6xl mx-auto py-12 bg-white">
		<div class="mx-auto px-4">
			{% if error %}
				<div class="text-center">
					<h1 class="text-3xl font-black text-red-600 mb-4">{{ error }}</h1>
					<a href="/products" class="bg-blue-600 text-white px-6 py-3 rounded-lg font-bold hover:bg-blue-700 transition duration-300">Browse All Products</a>
				</div>
			{% else %}
				<div
					class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 product-page">
					<!-- Product Images -->
					<div>
						<div class="bg-gray-100 rounded-xl p-0">
							{% if product.images and product.images|length > 0 %}
								<img src="{{ product.images[0] }}" alt="{{ product.name }}" class="w-full h-96 object-cover" id="main-image">
							{% else %}
								<img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80" alt="{{ product.name }}" class="w-full h-96 object-cover rounded-lg" id="main-image">
							{% endif %}
						</div>
						{% if product.images and product.images|length > 1 %}
							<div class="flex space-x-2 mt-4">
								{% for image in product.images %}
									<img src="{{ image }}" alt="{{ product.name }}" class="w-16 h-16 object-cover rounded-lg cursor-pointer border-2 border-transparent hover:border-blue-500 transition duration-300" onclick="changeImage('{{ image }}')">
								{% endfor %}
							</div>
						{% endif %}
					</div>

					<!-- Product Details -->
					<div>
						<h1 class="text-lg sm:text-xl lg:text-2xl font-black text-gray-900 mb-4">{{ product.name }}</h1>

						<div class="flex items-center mb-4">
							<div class="flex text-yellow-400 text-md sm:text-lg mr-4">
								{% for i in 1..5 %}
									<i class="fas fa-star"></i>
								{% endfor %}
							</div>
							<span class="text-gray-600">({{ random(100, 500) }}
								reviews)</span>
						</div>

						<div class="mb-6 gap-2">
							{% if sale_price %}
								<span class="text-md sm:text-xl text-gray-500 line-through ml-2">KSh
									{{ product.price|number_format }}</span>
								<span class="text-md sm:text-2xl font-black text-gray-900">KSh
									{{ sale_price|number_format }}</span>
								<div class="bg-red-500 text-white px-3 py-1 ml-3 rounded-full text-sm font-bold inline-block mt-2">
									{{ discount_display }}
								</div>
							{% else %}
								<span class="text-md sm:text-2xl font-black text-gray-900">KSh
									{{ product.price|number_format }}</span>
							{% endif %}
						</div>

						{# Cart management #}
						<div
							class="bg-white rounded-lg shadow-md p-2 sm:p-6 my-6 ">
							{# quantity selection #}
							<div class="mb-2">
								<div class="flex items-center gap-3 sm:gap-6 mb-4">
									<div>
										<span class="text-md sm:text-lg font-bold mr-4">Quantity:</span>
										<div class="flex items-center border border-gray-300 rounded-lg">
											<button class="px-1 sm:px-3 py-1 sm:py-2 text-gray-600 hover:text-gray-800" onclick="decreaseQty()">-</button>
											<input type="number" id="quantity" value="1" min="1" max="{{ product.stock_quantity }}" class="w-16 text-center text-xs sm:text-md border-0 focus:ring-0">
											<button class="px-1 sm:px-3 py-1 sm:py-2 text-gray-600 hover:text-gray-800" onclick="increaseQty()">+</button>
										</div>
									</div>
									{% if session.cart[product.id] %}
									<div>
										<span class="text-lg font-bold mr-4"></span>
										<button class="w-full bg-blue-600 text-white py-2 px-2 sm:px-5 text-xs sm:text-md rounded-lg font-bold hover:bg-blue-700 transition duration-300 flex items-center justify-center add-to-cart text-lg" data-product-id="{{ product.id }}" data-product-name="{{ product.name }}" data-product-price="{{ product.price }}">
											<i class="fas fa-cart-plus mr-3"></i>
											Add More To Cart
										</button>
									</div>
									{% endif %}
								</div>

								{% if product.variants and product.variants.attributes %}

									<h3 class="text-lg font-semibold text-gray-800 mb-4">
										Choose Options
									</h3>

									<div class="grid grid-cols-2 gap-4 space-y-4">

										{% for key, values in product.variants.attributes %}
											<div>

												<label class="block text-xs sm:text-sm font-medium text-gray-700 mb-1">
													{{ key|title }}
												</label>

												<select name="attributes[{{ key }}]" required class="product-attribute w-full p-2 border-gray-300 rounded-lg text-xs sm:text-sm shadow-sm focus:ring-2 focus:ring-blue-200 focus:border-blue-400" data-attribute="{{ key }}">

													{# <option class="p-2" selected disabled>Select
														{{ key|title }}</option> #}

													{% if values is iterable %}
														{% for value in values %}
															<option class="p-2 text-xs sm:text-md" value="{{ value }}">
																{{ value }}
															</option>
														{% endfor %}
													{% endif %}

												</select>

											</div>
										{% endfor %}

									</div>

								{% endif %}
							</div>

							{# add to cart #}
							{% if session.cart[product.id] %}

								<div
									class="grid grid-cols-2 gap-2 sm:gap-3 rounded-lg">

									<!-- REMOVE -->
									<button class="remove-from-cart px-2 sm:px-4 py-2 text-xs sm:text-md bg-red-500 text-white rounded-lg"  data-product-id="{{ product.id }}" data-product-name="{{ product.name }}">
										Remove from Cart
									</button>

									<!-- proceed to Cart -->
									<a href="/cart" class="w-full">
									<button class="w-full px-2 sm:px-4 py-2 text-xs sm:text-md bg-green-600 text-white rounded-lg">
										Proceed to Cart
									</button>
</a>
								</div>

							{% else %}
								<button class="w-full bg-blue-600 text-white py-4 rounded-lg font-bold hover:bg-blue-700 transition duration-300 flex items-center justify-center add-to-cart  text-md sm:text-lg" data-product-id="{{ product.id }}" data-product-name="{{ product.name }}" data-product-price="{{ product.price }}">

									<i class="fas fa-cart-plus mr-3"></i>
									Add to Cart
								</button>

							{% endif %}
						</div>
					</div>
				</div>

				<div class="container mx-auto my-6">
					<div class="mb-6">
						<h3 class="text-lg font-bold mb-2">Description</h3>
						<p class="text-sm sm:text-md text-gray-600">{{ product.description | raw}}</p>
					</div>

					{% if product.specs %}
						<div class="max-w-3xl mb-6">
							<h3 class=" text-md sm:text-lg font-bold mb-2">Product Specifications</h3>
							<div class="grid grid-cols-1">
								{% for key, value in product.specs %}
									<div class="grid grid-cols-2 space-x-2 border border-gray-200">
										<span class="font-bold text-xs sm:text-md text-gray-700 p-2 border-gray-200 border-r ">{{ key|replace({'_': ' '})|title }}</span>
										{% set decoded = value|json_decode %}

										{% if decoded is iterable %}
											<span class="text-gray-600 p-2  text-xs sm:text-md">
												{% if decoded|length > 0 and decoded|first is not iterable %}
													{{ decoded|join(', ') }}
												{% else %}
													<ul class="list-disc list-inside space-y-1 p-2">
														{% for k, v in decoded %}
															<li class="p-2 pr-4">
																<strong>{{ k|replace({'_': ' '})|title }}:</strong>
																{{ v }}
															</li>
														{% endfor %}
													</ul>
												{% endif %}
											</span>
										{% else %}
											<span class="text-xs sm:text-md text-gray-600 p-2 pr-4">{{ value }}</span>
										{% endif %}

									</div>
								{% endfor %}
							</div>
						</div>
					{% endif %}

					{% if product.tags|length > 0 %}
						<div class="max-w-3xl mb-6">
							<h3 class="text-xs sm:text-lg font-bold mb-2">More Specifications</h3>
							<div class="grid grid-cols-1">
								{% for tag in product.tags %}
									<div class="grid grid-cols-2 py-2 gap-2 border-b border-gray-200">
										<span class="text-xs sm:text-md font-medium text-gray-700">{{ tag.tag_name }}</span>
										<span class="text-xs sm:text-md text-gray-600">{{ tag.tag_value }}</span>
									</div>
								{% endfor %}
							</div>
						</div>
					{% endif %}

					<div class="bg-gray-50 p-4 rounded-lg">
						<div class="flex items-center text-xs sm:text-sm text-gray-600">
							<i class="fas fa-truck mr-2"></i>
							<span>Free delivery for orders above KSh 20,000</span>
						</div>
						<div class="flex items-center text-xs sm:text-sm text-gray-600 mt-2">
							<i class="fas fa-shield-alt mr-2"></i>
							<span>Genuine product straight from Manufacturer</span>
						</div>
					</div>
				</div>

				<!-- Related Products -->
				{% if related_products %}
					<section class="mt-8">
						<h2 class="text-2xl lg:text-3xl font-black text-gray-900 mb-4">Related Products</h2>
						<div class="flex gap-2 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-2 no-scrollbar">
							{% for related in related_products %}
								<div class="group flex-shrink-0 w-36 sm:w-48 snap-start">
									<a href="/products/{{ related.slug }}">
										<div class="relative">
											<img src="{{ related.images[0] }}" alt="{{ related.name }}" class="w-full h-40 lg:h-48 object-cover">
										</div>
										<div class="p-3 lg:p-4">
											<h3 class="font-bold text-xs lg:text-md mb-2 line-clamp-2">{{ related.name }}</h3>
											<div class="flex items-center justify-between">
												<span class="text-xs text-lg font-black text-gray-900">KSh
													{{ related.price|number_format }}</span>
											</div>
										</div>
									</a>
								</div>
							{% endfor %}
						</div>
					</section>
				{% endif %}
			{% endif %}
		</div>
	</section>
	<script>
		function changeImage(src) {
document.getElementById('main-image').src = src;
}

function increaseQty() {
const qty = document.getElementById('quantity');
const max = parseInt(qty.max);
const current = parseInt(qty.value);
if (current < max) {
qty.value = current + 1;
}
}

function decreaseQty() {
const qty = document.getElementById('quantity');
const current = parseInt(qty.value);
if (current > 1) {
qty.value = current - 1;
}
}
	</script>
{% endblock %}
