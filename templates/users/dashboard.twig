{% extends 'layout.twig' %}

{% block title %}My Account - {{ parent() }}{% endblock %}

{% block content %}
<div class="min-h-screen bg-gray-50 dark:bg-gray-900 py-8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="text-center mb-8">
            <div
                class="inline-flex items-center justify-center w-16 h-16 bg-blue-100 dark:bg-blue-900 rounded-full mb-4">
                <i class="fas fa-user text-primary-600 dark:text-primary-400 text-xl"></i>
            </div>
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">My Account</h1>
            <p class="text-gray-600 dark:text-gray-400">Welcome back, {{ session.user_name }}!</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left Column - Quick Stats -->
            <div class="lg:col-span-1 space-y-6">
                <!-- User Info Card -->
                <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm p-6">
                    <div class="flex items-center space-x-4 mb-4">
                        <div
                            class="w-12 h-12 bg-blue-100 dark:bg-blue-900 rounded-full flex items-center justify-center">
                            <i class="fas fa-user-circle text-primary-600 dark:text-primary-400 text-xl"></i>
                        </div>
                        <div>
                            <h3 class="font-semibold text-gray-900 dark:text-white">{{ session.user_name }}</h3>
                            <p class="text-sm text-gray-600 dark:text-gray-400">{{ session.user_email }}</p>
                        </div>
                    </div>

                    <div class="space-y-2 text-sm">
                        <div class="flex justify-between">
                            <span class="text-gray-600 dark:text-gray-400">Member since</span>
                            <span class="text-gray-900 dark:text-white">{{session.user.created_at | date('M Y')}}</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-600 dark:text-gray-400">Status</span>
                            <span class="text-green-600 dark:text-green-400">Active</span>
                        </div>
                        <a href="/user/account/wishlist"
                            class="flex items-center space-x-3 p-3 rounded-lg bg-blue-100 hover:bg-blue-300 dark:hover:bg-gray-700 transition-colors">
                            <i class="fas fa-user-edit text-gray-400 text-lg"></i>
                            <span class="text-gray-700 dark:text-gray-300">Wishlist</span>
                        </a>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm p-6">
                    <h3 class="font-semibold text-gray-900 dark:text-white mb-4">Quick Actions</h3>
                    <div class="space-y-3">
                        <a href="/user/account/profile"
                            class="flex items-center space-x-3 p-3 rounded-lg bg-gray-100 hover:bg-gray-300 dark:hover:bg-gray-700 transition-colors">
                            <i class="fas fa-user-edit text-gray-400 text-lg"></i>
                            <span class="text-gray-700 dark:text-gray-300">Edit Profile</span>
                        </a>
                        <a href="/user/account/addresses"
                            class="flex items-center space-x-3 p-3 rounded-lg bg-gray-100 hover:bg-gray-300 dark:hover:bg-gray-700 transition-colors">
                            <i class="fas fa-map-marker-alt text-gray-400 text-lg"></i>
                            <span class="text-gray-700 dark:text-gray-300">Addresses</span>
                        </a>
                        <a href="/support"
                            class="flex items-center space-x-3 p-3 rounded-lg bg-gray-100 hover:bg-gray-300 dark:hover:bg-gray-700 transition-colors">
                            <i class="fas fa-headset text-gray-400 text-lg"></i>
                            <span class="text-gray-700 dark:text-gray-300">Support</span>
                        </a>
                        <!-- Logout Button -->
                        <form action="/logout" method="POST" class="pt-4">
                            <input type="hidden" name="_token" value="{{ session.csrf_token }}">
                            <button type="submit"
                                class="w-full flex items-center justify-center space-x-2 py-3 px-4 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-red-300 dark:hover:bg-gray-700 transition-colors">
                                <i class="fas fa-sign-out-alt"></i>
                                <span>Sign Out</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Column - Main Content -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Orders Section -->
                <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm p-6">
                    <div class="flex items-center justify-between mb-6">
                        <h2 class="text-xl font-bold text-gray-900 dark:text-white">Recent Orders</h2>
                        <a href="/user/account/orders"
                            class="text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300 text-sm font-medium">
                            View All
                        </a>
                    </div>

                    {% if orders and orders|length > 0 %}
                    <div class="space-y-4">
                        {% for order in orders|slice(0, 3) %}
                        <div
                            class="flex items-center justify-between p-4 border border-gray-200 dark:border-gray-700 rounded-lg">
                            <div class="flex items-center space-x-4">
                                <div
                                    class="w-10 h-10 bg-blue-100 dark:bg-blue-900 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-shopping-bag text-primary-600 dark:text-primary-400"></i>
                                </div>
                                <div>
                                    <h4 class="font-medium text-gray-900 dark:text-white">{{ order.order_number }}</h4>
                                    <p class="text-sm text-gray-600 dark:text-gray-400">
                                        {{ order.created_at|date("M j, Y") }} • KSh {{
                                        order.total_amount|number_format(2) }}
                                    </p>
                                </div>
                            </div>
                            <div class="text-right">
                                <span
                                    class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium 
                                    {% if order.status == 'delivered' %}bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300
                                    {% elseif order.status == 'processing' %}bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300
                                    {% elseif order.status == 'pending' %}bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-300
                                    {% else %}bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300{% endif %}">
                                    {{ order.status|title }}
                                </span>
                                <a href="/user/account/orders/{{ order.id }}"
                                    class="block text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300 text-sm mt-1">
                                    View Details
                                </a>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                    {% else %}
                    <div class="text-center py-8">
                        <i class="fas fa-shopping-bag text-gray-300 dark:text-gray-600 text-3xl mb-3"></i>
                        <p class="text-gray-600 dark:text-gray-400 mb-4">No orders yet</p>
                        <a href="/electronics"
                            class="inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors">
                            <i class="fas fa-shopping-cart mr-2"></i>
                            Start Shopping
                        </a>
                    </div>
                    {% endif %}
                </div>

                <!-- Quick Stats -->
                <div class="grid grid-cols-2 gap-4">
                    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm p-4 text-center">
                        <div
                            class="w-12 h-12 bg-blue-100 dark:bg-blue-900 rounded-full flex items-center justify-center mx-auto mb-2">
                            <i class="fas fa-shopping-bag text-blue-600 dark:text-blue-400"></i>
                        </div>
                        <h3 class="text-2xl font-bold text-gray-900 dark:text-white">{{ total_orders ?? 0 }}</h3>
                        <p class="text-sm text-gray-600 dark:text-gray-400">Total Orders</p>
                    </div>

                    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm p-4 text-center">
                        <div
                            class="w-12 h-12 bg-green-100 dark:bg-green-900 rounded-full flex items-center justify-center mx-auto mb-2">
                            <i class="fas fa-check-circle text-green-600 dark:text-green-400"></i>
                        </div>
                        <h3 class="text-2xl font-bold text-gray-900 dark:text-white">{{ completed_orders ?? 0 }}</h3>
                        <p class="text-sm text-gray-600 dark:text-gray-400">Completed</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}