{% extends "layout.twig" %}

{% block content %}
	<section class="max-w-6xl mx-auto py-4 sm:py-12 bg-gray-50">
		<div class="container mx-auto px-4">
			<h1 class="text-xl lg:text-4xl font-black text-center sm:mb-4 text-gray-900">Shop By Category</h1>
			<p class="text-center text-gray-600 lg:mb-12 text-lg">Everything you need in one place</p>
			<div class="grid grid-cols-2 md:grid-cols-3 space-y-3 mb-6">
				{% for category in categories %}
					<div class="flex items-center justify-between p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">
						<a href="/category/{{ category.slug }}">
							<div class="flex items-center space-x-3">
								{% if category.image_url %}
									<img src="{{ category.image_url }}" alt="{{ category.name }}" class="w-10 h-10 rounded-lg object-cover">
								{% else %}
									<div class="w-10 h-10 bg-blue-100 dark:bg-blue-900 rounded-lg flex items-center justify-center">
										<i class="fas fa-mobile-alt text-blue-600 dark:text-blue-400"></i>
									</div>
								{% endif %}
								<div>
									<h4 class="text-xs sm:text-sm font-medium text-gray-900 dark:text-white">{{ category.name }}</h4>
									<p class="text-xs text-gray-500 dark:text-gray-400">{{ category.products_count }}
										products</p>
								</div>
							</div>
						</a>
					</div>
				{% else %}
					<p class="text-sm text-gray-500 dark:text-gray-400 text-center py-4">No categories found</p>
				{% endfor %}
			</div>
            
		<section class="max-w-6xl mx-auto bg-gradient-to-r from-red-50 to-orange-50 border-t border-b border-red-200">
			<div
				class="container mx-auto">
				<!-- Header -->
				<div class="bg-gradient-to-r from-red-600 to-orange-600 px-3 sm:px-6 py-3">
					<div class="flex justify-between items-center">
						<div class="flex-row sm:flex items-center space-x-4">
							<div class="flex items-center space-x-2">
								<i class="fas fa-bolt text-xl animate-pulse"></i>
								<div>
									<h2 class="text-[12px] sm:text-xl">Featured Products</h2>
									<div class="text-[10px] sm:text-sm font-normal opacity-90">Discover best sellers</div>
								</div>
							</div>
						</div>
						<a href="/products/featured" class=" hidden sm:block text-white hover:text-pink-200 text-[12px] sm:text-md font-semibold sm:font-bold">
							View All
							<i class="fas fa-arrow-right ml-2"></i>
						</a>
					</div>
				</div>

				<!-- Flash Sale Products Grid -->
				<div class="py-2">
					<div class="flex gap-2 overflow-x-auto scroll-smooth snap-x snap-mandatory no-scrollbar">
						{% for product in featured_products %}
							<div class="group flex-shrink-0 w-36 sm:w-48 snap-start">
								<a href="/products/{{product.slug}}">
									<div class="relative">
										{% if product.images and product.images|length > 0 %}
											<img src="{{ product.images[0] }}" alt="{{ product.name }}" class="w-full  h-32 sm:h-40 object-cover">
										{% endif %}

										<!-- Overlay on hover -->
										<div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
									</div>
								</a>

								<div class="pt-2 sm:p-1">
									<h3 class="text-[12px] min-h-8 sm:min-h-10 sm:text-md font-semibold sm:font-bold text-gray-900 line-clamp-2">{{ product.name }}</h3>

									<!-- Price -->
									<div class="mb-1">
										<div class="flex items-center space-x-2">
											<span class="text-xs sm:text-xl font-black text-red-600">KSh
												{{ product.price|number_format }}</span>
										</div>
									</div>
								</div>

								<div
									class="grid grid-cols-12 space-x-1 mb-3">
									<!-- Add to Cart Button -->
									<div class="col-span-8">
										<button class="w-full bg-gradient-to-r from-red-600 to-orange-500 text-[10px] sm:text-md text-white py-3 rounded-lg font-bold hover:from-red-700 hover:to-orange-600 transition-all duration-200 transform hover:scale-[1.02] shadow-md hover:shadow-lg add-to-cart" data-product-id="{{ product.id }}" data-product-name="{{ product.name }}">
											<i class="fas fa-cart-plus mr-2"></i>
											Add to Cart
										</button>
									</div>
									<div class="col-span-4">
										<button class="bg-red-50 text-gray-700 p-2 rounded-full hover:bg-red-600 hover:text-white transition-colors add-to-wishlist" data-product-id="{{ product.id }}" data-product-name="{{ product.name }}">
											<i class="far fa-heart"></i>
										</button>
									</div>
								</div>
							</div>
						{% endfor %}
					</div>
					<a href="/sales" class="sm:hidden text-red-600 font-bold hover:text-red-800 transition duration-200 flex items-center space-x-2 px-4 py-2 hover:border-red-400">
						<span>View All Deals</span>
						<i class="fas fa-arrow-right"></i>
					</a>
				</div>
			</div>
		</section>
		</div>
	</section>
{% endblock %}
