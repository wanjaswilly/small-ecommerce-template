<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

		<title>
			{% block title %}
				Duka - {{ __('home')|title }} - {{ __('shop')|title }}
			{% endblock %}
		</title>

		<meta name="description" content="{% block description %}{{ __('Your trusted partner for quality products in Kenya') }}{% endblock %}"/>
		<meta name="author" content="Duka"/>
		<meta
		name="keywords" content="electronics, fashion, home, Kenya, Nairobi, smartphones, laptops, traditional crafts"/>

		<!-- Open Graph (OG) Tags for social media -->
		<meta property="og:title" content="{% block og_title %}Small Ecommerce - Quality Products for day to day use{% endblock %}"/>
		<meta property="og:description" content="{% block og_description %}Your trusted partner for quality electronics and genuine car spare parts in Ngara, Nairobi. Free CBD delivery available.{% endblock %}"/>
		<meta property="og:type" content="website"/>
		<meta property="og:url" content="{{ app_url|default('https://smallecommerce.co.ke') }}"/>
		<meta property="og:image" content="{% block og_image %}{{ app_url }}/assets/og-image.jpg{% endblock %}"/>

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image"/>
		<meta name="twitter:title" content="{% block twitter_title %}Small Ecommerce - Quality Products for day to day use{% endblock %}"/>
		<meta name="twitter:description" content="{% block twitter_description %}Your trusted partner for quality electronics and genuine car spare parts in Ngara, Nairobi. Free CBD delivery available.{% endblock %}"/>
		<meta name="twitter:image" content="{% block twitter_image %}{{ app_url }}/assets/twitter-card.jpg{% endblock %}"/>

		<!-- Canonical URL -->
		<link rel="canonical" href="{% block canonical %}{{ app_url }}{{ request_uri }}{% endblock %}"/>

		<!-- Structured Data -->
		
<script type="application/ld+json">{% block structured_data %}{% endblock %}</script>	

		<meta name="csrf-token" content="{{ csrf_token() | raw  }}">
		<!-- Tailwind CSS -->
		<link rel="stylesheet" href="{{ asset('/build/assets/app.css') }}"/>
		<script type="module" src="{{ asset('/build/assets/app-CQBL56Kt.js') }}"></script>

		<!-- Additional Styles -->
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
		<link
		href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

		<!-- Favicon -->
		<link rel="icon" href="/favicon.ico" type="image/x-icon"/> {% block styles %}{% endblock %}
		</head>
		<body class="bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 font-sans  pb-15 sm:pb-0">
			{% include 'partials/header.twig' %}

			<main>
				{% block content %}{% endblock %}
			</main>

{% include 'partials/footer.twig' %}

{% include 'partials/whatsapp.twig' %}

{% include 'partials/cookie-banner.twig' %}

<script>
// Newsletter subscription
document.addEventListener('DOMContentLoaded', function() {
    const newsletterForm = document.getElementById('newsletter-form');
    const newsletterMessage = document.getElementById('newsletter-message');

    if (newsletterForm) {
        newsletterForm.addEventListener('submit', function(e) {
            e.preventDefault();

            const formData = new FormData(this);
            const email = formData.get('email');

            fetch('/newsletter/subscribe', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: new URLSearchParams(formData)
            })
            .then(response => response.json())
            .then(data => {
                newsletterMessage.className = data.success ? 'mt-2 text-center text-sm text-green-400' : 'mt-2 text-center text-sm text-red-400';
                newsletterMessage.textContent = data.message;
                newsletterMessage.classList.remove('hidden');

                if (data.success) {
                    newsletterForm.reset();
                }
            })
            .catch(error => {
                console.error('Error:', error);
                newsletterMessage.className = 'mt-2 text-center text-sm text-red-400';
                newsletterMessage.textContent = 'An error occurred. Please try again.';
                newsletterMessage.classList.remove('hidden');
            });
        });
    }
});
</script>

{% block scripts %}{% endblock %}
		</body>
	</html>
