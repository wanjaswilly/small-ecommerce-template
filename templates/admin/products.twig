{% extends "admin.twig" %}

{% block title %}Products Management
{% endblock %}

{% block page_title %}Products Management
{% endblock %}

{% block page_description %}Manage all products in the system
{% endblock %}

{% block page_breadcrumb %}
	<span class="mx-2">/</span>
	<span class="text-gray-800 dark:text-gray-200">Products</span>
{% endblock %}

{% block page_actions %}
	<div class="flex space-x-3">
		<a href="/admin/products/create" class="bg-primary-600 hover:bg-primary-700 text-white px-4 py-2 rounded-lg transition-colors duration-300 flex items-center">
			<i class="fas fa-plus mr-2"></i>
			Add Product
		</a>
	</div>
{% endblock %}

{% block content %}
	<div
		class="px-4 sm:px-6 lg:px-8 py-8">
		<!-- Header -->
		<div class="sm:flex sm:items-center sm:justify-between mb-8">
			<div class="sm:flex-auto">
				<h1 class="text-2xl font-semibold text-gray-900">Products Management</h1>
				<p class="mt-2 text-sm text-gray-700">Manage warehouse products and their inventories</p>
			</div>
			<div class="mt-4 sm:mt-0 sm:ml-16 sm:flex-none">
				<a href="/admin/products/create" class="inline-flex items-center justify-center rounded-md border border-transparent bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-blue-700">
					<svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewbox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
					</svg>
					Add Product
				</a>
			</div>
		</div>

		<!-- Stats -->
		<div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4 mb-8">
			<div class="bg-white overflow-hidden shadow rounded-lg">
				<div class="p-5">
					<div class="flex items-center">
						<div class="flex-shrink-0 bg-blue-500 rounded-md p-3">
							<svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewbox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
							</svg>
						</div>
						<div class="ml-5 w-0 flex-1">
							<dl>
								<dt class="text-sm font-medium text-gray-500 truncate">Total Products</dt>
								<dd class="text-lg font-medium text-gray-900">{{ products.total }}</dd>
							</dl>
						</div>
					</div>
				</div>
			</div>

			<div class="bg-white overflow-hidden shadow rounded-lg">
				<a href="/admin/products?is_active=1">
					<div class="p-5">
						<div class="flex items-center">
							<div class="flex-shrink-0 bg-green-500 rounded-md p-3">
								<svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewbox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
								</svg>
							</div>
							<div class="ml-5 w-0 flex-1">
								<dl>
									<dt class="text-sm font-medium text-gray-500 truncate">Active</dt>
									<dd class="text-lg font-medium text-gray-900">{{ products.active }}</dd>
								</dl>
							</div>
						</div>
					</div>

				</a>
			</div>

			<div class="bg-white overflow-hidden shadow rounded-lg">
				<a href="/admin/products?is_active=1">
					<div class="p-5">
						<div class="flex items-center">
							<div class="flex-shrink-0 bg-yellow-500 rounded-md p-3">
								<svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewbox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
								</svg>
							</div>
							<div class="ml-5 w-0 flex-1">
								<dl>
									<dt class="text-sm font-medium text-gray-500 truncate">Inactive</dt>
									<dd class="text-lg font-medium text-gray-900">{{ products.inactive }}</dd>
								</dl>
							</div>
						</div>
					</div>
				</a>
			</div>

			<div class="bg-white overflow-hidden shadow rounded-lg">
				<div class="p-5">
					<div class="flex items-center">
						<div class="flex-shrink-0 bg-purple-500 rounded-md p-3">
							<svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewbox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
							</svg>
						</div>
						<div class="ml-5 w-0 flex-1">
							<dl>
								<dt class="text-sm font-medium text-gray-500 truncate">Low Stock</dt>
								<dd class="text-lg font-medium text-gray-900">{{ products.lowstock }}</dd>
							</dl>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700">
		<div class="p-6 border-b border-gray-200 dark:border-gray-700">
			<form action="/admin/products" method="GET">
				<div class="flex flex-col md:flex-row md:items-center md:justify-between">
					<div class="flex-row sm:flex space-y-1 sm:space-y-0 items-center space-x-4">
						<div class="relative">
							<input type="text" name="search" placeholder="Search products..." class="pl-6 sm:pl-10 sm:pr-4 py-1 sm:py-2 text-xs sm:text-md border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent w-50 sm:w-64" value="{{ search }}">
							<i class="fas fa-search absolute left-1 top-2 text-gray-400 text-xs sm:text-md px-1"></i>
						</div>
						<select name="category_id" class="px-1 sm:px-3 py-1 sm:py-2 text-xs sm:text-md border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500">
							<option value="">All Categories</option>
							{% for category in categories %}
								<option value="{{ category.id }}" {% if category.id == selected_category %} selected {% endif %}>{{ category.name }}</option>
							{% endfor %}
						</select>
						<select name="is_active" class="px-1 sm:px-3 py-1 sm:py-2 text-xs sm:text-md border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500">
							<option value="">All Status</option>
							<option value="1" {% if selected_active == '1' %} selected {% endif %}>Active</option>
							<option value="0" {% if selected_active == '0' %} selected {% endif %}>Inactive</option>
						</select>

						<input type="submit" value='Filter' class="py-1 sm:py-2 text-xs sm:text-md px-3 bg-blue-500 rounded-lg">
					</div>
					<div class="mt-4 md:mt-0">
						<span class="text-sm text-gray-600 dark:text-gray-400">Total:
							{{ products.total }}
							products</span>
					</div>
				</div>
			</form>
		</div>

		<div class="overflow-x-auto">
			<table class="w-full">
				<thead class="bg-gray-50 dark:bg-gray-700">
					<tr>
						<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Product</th>
						<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Price</th>
						<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Stock</th>
						<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Status</th>
						<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Actions</th>
					</tr>
				</thead>
				<tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
					{% for product in products %}
						<tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
							<td class="px-6 py-4 whitespace-nowrap">
								<div class="flex items-center">
									{% if product.images and product.images[0] %}
										<img class="h-10 w-10 rounded-lg object-cover" src="{{ product.images[0] }}" alt="{{ product.name }}">
									{% else %}
										<div class="h-10 w-10 rounded-lg bg-gray-200 dark:bg-gray-600 flex items-center justify-center">
											<i class="fas fa-box text-gray-400"></i>
										</div>
									{% endif %}
									<div class="ml-4">
										<div class="text-sm font-medium text-gray-900 dark:text-white">{{ product.name }}</div>
										<div class="text-sm text-gray-500 dark:text-gray-400">{{ product.category.name }}</div>
									</div>
								</div>
							</td>
							<td class="px-6 py-4 whitespace-nowrap">
								<div class="text-sm text-gray-900 dark:text-white">KSh
									{{ product.price|number_format(0, '.', ',') }}</div>
							</td>
							<td class="px-6 py-4 whitespace-nowrap">
								<div class="text-sm text-gray-900 dark:text-white">{{ product.stock_quantity }}</div>
								{# <div class="text-sm text-gray-900 dark:text-white">Variants: {{ product.variants|length }}</div> #}
							</td>
							<td class="px-6 py-4 whitespace-nowrap">
								{% if product.is_active %}
									<span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
										Active
									</span>
								{% else %}
									<span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200">
										Inactive
									</span>
								{% endif %}

								{% if product.stock_quantity <= product.min_stock_level %}
									<div class="text-xs text-red-600 dark:text-red-400">Low stock</div>
								{% endif %}
							</td>
							<td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
								<div class="flex items-center space-x-2">
									<a href="/products/{{ product.slug }}" target="_blank" class="text-blue-600 hover:text-blue-900 dark:hover:text-blue-400">
										<i class="fas fa-eye"></i>
									</a>
									<a href="/admin/products/{{ product.id }}/variant/create" class="text-blue-600 hover:text-blue-900 dark:hover:text-blue-400">
										<i class="fas fa-plus"></i>
									</a>
									<a href="/admin/products/{{ product.id }}/edit" class="text-blue-600 hover:text-blue-900 dark:hover:text-blue-400">
										<i class="fas fa-edit"></i>
									</a>
									<form action="/admin/products/{{ product.id }}/delete" method="POST" class="inline">
										<input type="hidden" name="_method" value="DELETE">
										{{ csrf_field() |raw}}
										<button type="submit" class="text-red-600 hover:text-red-900 dark:hover:text-red-400" onclick="return confirm('Are you sure you want to delete this product?')">
											<i class="fas fa-trash"></i>
										</button>
									</form>
								</div>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>

		<!-- Pagination -->
		{% if products.hasPages() %}
			<div class="mt-12 flex justify-center mb-6">
				<div class="flex space-x-2">
					{% if products.onFirstPage %}
						<span class="px-1 sm:px-3 py-1 sm:py-2 text-xs sm:text-md bg-gray-200 text-gray-500 rounded-lg cursor-not-allowed">Previous</span>
					{% else %}
						<a href="?page={{ products.currentPage - 1 }}{{ query_string }}" class="px-1 sm:px-3 py-1 sm:py-2 text-xs sm:text-md bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition duration-300">Previous</a>
						<a href="?page={{ products.currentPage - 1 }}{{ query_string }}" class="px-1 sm:px-3 py-1 sm:py-2 text-xs sm:text-md bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition duration-300">{{ products.currentPage - 1 }}</a>
					{% endif %}

					{% if (products.lastPage - 1) > 3 %}
						<span class="px-1 sm:px-3 py-1 sm:py-2 text-xs sm:text-md bg-blue-600 text-white rounded-lg">{{ products.currentPage }}</span>
						{% if  products.currentPage != products.lastPage %}
							<a href="?page={{ products.currentPage + 1 }}{{ query_string }}" class="px-1 sm:px-3 py-1 sm:py-2 text-xs sm:text-md bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition duration-300">{{ products.currentPage + 1 }}</a>
						{% endif %}

						{% if products.currentPage < products.lastPage - 2 %}
							<a class="px-1 sm:px-3 py-1 sm:py-2 text-xs sm:text-md bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition duration-300">...</a>
							<a href="?page={{ products.lastPage - 2 }}{{ query_string }}" class="px-1 sm:px-3 py-1 sm:py-2 text-xs sm:text-md bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition duration-300">{{ products.lastPage - 1 }}</a>
						{% endif %}
						{% if products.currentPage < products.lastPage - 1 %}
							<a href="?page={{ products.lastPage - 1 }}{{ query_string }}" class="px-1 sm:px-3 py-1 sm:py-2 text-xs sm:text-md bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition duration-300">{{ products.lastPage }}</a>
						{% endif %}
					{% else %}
						{{products.lastPage}}
						{% for page in 1..products.lastPage %}
							{% if page == products.currentPage %}
								<span class="px-1 sm:px-3 py-1 sm:py-2 text-xs sm:text-md bg-blue-600 text-white rounded-lg">{{ page }}</span>
							{% else %}
								<a href="?page={{ page }}{{ query_string }}" class="px-1 sm:px-3 py-1 sm:py-2 text-xs sm:text-md bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition duration-300">{{ page }}</a>
							{% endif %}
						{% endfor %}

					{% endif %}


					{# {% for page in 1..products.lastPage %}
																																										{% if page == products.currentPage %}
																																											<span class="px-1 sm:px-3 py-1 sm:py-2 text-xs sm:text-md bg-blue-600 text-white rounded-lg">{{ page }}</span>
																																										{% else %}
																																											<a href="?page={{ page }}{{ query_string }}" class="px-1 sm:px-3 py-1 sm:py-2 text-xs sm:text-md bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition duration-300">{{ page }}</a>
																																										{% endif %}
																																									{% endfor %} #}

					{% if products.hasMorePages %}
						<a href="?page={{ products.currentPage + 1 }}{{ query_string }}" class="px-1 sm:px-3 py-1 sm:py-2 text-xs sm:text-md bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition duration-300">Next</a>
					{% else %}
						<span class="px-1 sm:px-3 py-1 sm:py-2 text-xs sm:text-md bg-gray-200 text-gray-500 rounded-lg cursor-not-allowed">Next</span>
					{% endif %}
				</div>
			</div>
		{% endif %}
	</div>
{% endblock %}
