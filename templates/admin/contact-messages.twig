{% extends "admin.twig" %}

{% block title %}Contact Messages Management
{% endblock %}

{% block page_title %}Contact Messages Management
{% endblock %}

{% block page_description %}Manage all contact messages in the system
{% endblock %}

{% block page_breadcrumb %}
	<span class="mx-2">/</span>
	<span class="text-gray-800 dark:text-gray-200">Contact Messages</span>
{% endblock %}


{% block content %}
	<div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700">
		<div class="p-6 border-b border-gray-200 dark:border-gray-700">
			<div class="flex flex-col md:flex-row md:items-center md:justify-between">
				<div class="flex items-center space-x-4">
					<div class="relative">
						<input type="text" placeholder="Search messages..." class="pl-10 pr-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent w-64" value="{{ search }}">
						<i class="fas fa-search absolute left-3 top-3 text-gray-400"></i>
					</div>
					<select class="px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500">
						<option value="">All Status</option>
						<option value="1" {% if selected_active == '1' %} selected {% endif %}>Replied</option>
						<option value="0" {% if selected_active == '0' %} selected {% endif %}>Not Replied</option>
					</select>
				</div>
				<div class="mt-4 md:mt-0">
					<span class="text-sm text-gray-600 dark:text-gray-400">Total:
						{{ messages |length }}
						Messages</span>
				</div>
			</div>
		</div>

		<div class="overflow-x-auto">
			<table class="w-full">
				<thead class="bg-gray-50 dark:bg-gray-700">
					<tr>
						<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Full Name</th>
						<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Phone Number</th>
						<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Message</th>
						<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Status</th>
						<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Actions</th>
					</tr>
				</thead>
				<tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
					{% for message in messages %}
						<tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
							<td class="px-6 py-4 whitespace-nowrap">
								<div class="flex items-center">
									<div class="ml-4">
										<div class="text-sm font-medium text-gray-900 dark:text-white">{{ message.fullname }}</div>
										<div class="text-sm text-gray-500 dark:text-gray-400">{{ message.email }}</div>
									</div>
								</div>
							</td>
							<td class="px-6 py-4 whitespace-nowrap">
								<div class="text-sm text-gray-900 dark:text-white">{{ message.phonenumber }}</div>
							</td>
							<td class="px-6 py-4 whitespace-nowrap">
								<div class="text-sm text-gray-900 dark:text-white">{{ message.message }}</div>
							</td>
							<td class="px-6 py-4 whitespace-nowrap">
								{% if not message.repliedat %}
									<span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200">
										Not Replied
									</span>
								{% else %}
									<div class="text-sm font-medium text-gray-900 dark:text-white">Replied by {{ message.repliedby.first_name }} {{ message.repliedby.last_name }}</div>
									<div class="text-sm text-gray-500 dark:text-gray-400">Replied on {{ message.repliedat|date('F d, Y \\a\\t g:i A') }}</div>
								{% endif %}
							</td>
							<td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
								<div class="flex items-center space-x-2">
									<a href="/admin/contact-message/{{ message.id }}/view" class="text-blue-600 hover:text-blue-900 dark:hover:text-blue-400">
										<i class="fas fa-eye"></i>
									</a>
									<a href="/admin/contact-message/{{ message.id }}/reply" class="text-blue-600 hover:text-blue-900 dark:hover:text-blue-400">
										<i class="fas fa-edit"></i>
									</a>
								</div>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>

		<!-- Pagination -->
		{% if messages.hasPages() %}
			<div class="mt-12 flex justify-center">
				<div class="flex space-x-2">
					{% if messages.onFirstPage %}
						<span class="px-3 py-2 bg-gray-200 text-gray-500 rounded-lg cursor-not-allowed">Previous</span>
					{% else %}
						<a href="?page={{ messages.currentPage - 1 }}{{ query_string }}" class="px-3 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition duration-300">Previous</a>
					{% endif %}

					{% if (messages.lastPage - 1) > 3 %}
						<span class="px-3 py-2 bg-blue-600 text-white rounded-lg">{{ messages.currentPage }}</span>
						{% if  messages.currentPage != messages.lastPage %}
							<a href="?page={{ messages.currentPage + 1 }}{{ query_string }}" class="px-3 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition duration-300">{{ messages.currentPage + 1 }}</a>
						{% endif %}

						{% if messages.currentPage < messages.lastPage - 2 %}
							<a class="px-3 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition duration-300">...</a>
							<a href="?page={{ messages.lastPage - 2 }}{{ query_string }}" class="px-3 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition duration-300">{{ messages.lastPage - 1 }}</a>
						{% endif %}
						{% if messages.currentPage < messages.lastPage - 1 %}
							<a href="?page={{ messages.lastPage - 1 }}{{ query_string }}" class="px-3 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition duration-300">{{ messages.lastPage }}</a>
						{% endif %}
					{% else %}
						{{messages.lastPage}}
						{% for page in 1..messages.lastPage %}
							{% if page == messages.currentPage %}
								<span class="px-3 py-2 bg-blue-600 text-white rounded-lg">{{ page }}</span>
							{% else %}
								<a href="?page={{ page }}{{ query_string }}" class="px-3 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition duration-300">{{ page }}</a>
							{% endif %}
						{% endfor %}

					{% endif %}


					{# {% for page in 1..messages.lastPage %}
																											{% if page == messages.currentPage %}
																												<span class="px-3 py-2 bg-blue-600 text-white rounded-lg">{{ page }}</span>
																											{% else %}
																												<a href="?page={{ page }}{{ query_string }}" class="px-3 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition duration-300">{{ page }}</a>
																											{% endif %}
																										{% endfor %} #}

					{% if messages.hasMorePages %}
						<a href="?page={{ messages.currentPage + 1 }}{{ query_string }}" class="px-3 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition duration-300">Next</a>
					{% else %}
						<span class="px-3 py-2 bg-gray-200 text-gray-500 rounded-lg cursor-not-allowed">Next</span>
					{% endif %}
				</div>
			</div>
		{% endif %}

	</div>
{% endblock %}
