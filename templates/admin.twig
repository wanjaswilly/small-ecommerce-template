							</li>
							<li class="mb-1">
								<a href="/admin/reviews" class="flex items-center p-2 rounded hover:bg-blue-700 dark:hover:bg-gray-700 transition-colors duration-300 {% if current_page == 'reviews' %}bg-blue-700{% endif %}">
