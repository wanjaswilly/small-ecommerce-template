						</button>

						<!-- Breadcrumb -->
						<div class="hidden md:flex items-center text-sm text-gray-600 dark:text-gray-400">
							<a href="/admin" class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-300">
								<i class="fas fa-home mr-1"></i>
								Admin
							</a>
							{% block page_breadcrumb %}
								<span class="mx-2">/</span>
								<span class="text-gray-800 dark:text-gray-200"></span>
							{% endblock %}
						</div>

						<!-- Right side actions -->
						<div class="flex items-center space-x-4">
							<!-- Notifications -->
							<div class="relative">
								<button class="text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 transition-colors duration-300 relative">
									<i class="fas fa-bell text-xl"></i>
