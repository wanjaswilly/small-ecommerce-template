<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Order Confirmation</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; padding: 20px; background: #f5f5f5; }
        .container { max-width: 600px; margin: 0 auto; background: white; padding: 30px; border-radius: 8px; }
        .header { text-align: center; margin-bottom: 30px; }
        .logo { color: #2563eb; font-size: 24px; font-weight: bold; }
        .order-info { background: #f8fafc; padding: 20px; border-radius: 8px; margin-bottom: 20px; }
        .order-number { font-size: 20px; font-weight: bold; color: #1e293b; }
        .items-table { width: 100%; border-collapse: collapse; margin: 20px 0; }
        .items-table th, .items-table td { padding: 12px; text-align: left; border-bottom: 1px solid #e2e8f0; }
        .items-table th { background: #f8fafc; font-weight: 600; }
        .total-row { font-weight: bold; font-size: 18px; }
        .footer { text-align: center; margin-top: 30px; color: #64748b; font-size: 14px; }
        .btn { display: inline-block; background: #2563eb; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; margin-top: 20px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div class="logo">{{ app_name|default('Ecommerce Store') }}</div>
            <h1>Order Confirmation</h1>
        </div>

        <p>Hi {{ customer_name }},</p>
        
        <p>Thank you for your order! We've received your order and are preparing it for shipment.</p>

        <div class="order-info">
            <p><strong>Order Number:</strong> <span class="order-number">{{ order_number }}</span></p>
            <p><strong>Order Date:</strong> {{ created_at|date('F j, Y') }}</p>
            <p><strong>Payment Method:</strong> {{ payment_method|title }}</p>
            <p><strong>Order Status:</strong> {{ status|title }}</p>
        </div>

        <h3>Order Items</h3>
        <table class="items-table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Qty</th>
                    <th>Price</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                <tr>
                    <td>{{ item.product.name }}</td>
                    <td>{{ item.quantity }}</td>
                    <td>KSh {{ item.unit_price|number_format }}</td>
                    <td>KSh {{ item.total_price|number_format }}</td>
                </tr>
                {% endfor %}
                <tr class="total-row">
                    <td colspan="3">Total Amount:</td>
                    <td>KSh {{ total_amount|number_format }}</td>
                </tr>
            </tbody>
        </table>

        <p><strong>Delivery Address:</strong><br>
        {{ delivery_location }}<br>
        {% if specific_address %}{{ specific_address }}<br>{% endif %}
        {% if delivery_notes %}{{ delivery_notes }}{% endif %}</p>

        <a href="{{ tracking_url }}" class="btn">Track Your Order</a>

        <div class="footer">
            <p>Thank you for shopping with us!</p>
            <p>{{ app_name|default('Ecommerce Store') }} - {{ app_url }}</p>
        </div>
    </div>
</body>
</html>