							{# <!-- Dark Mode Toggle -->
																												                        <button id="darkModeToggle" class="text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 transition-colors duration-300">
																												                            <i class="fas fa-moon text-xl" id="darkIcon"></i>
