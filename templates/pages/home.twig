{% extends "layout.twig" %}

{% block content %}
<!-- Mega Header Bar with Announcements -->
<div class="bg-red-600 text-white py-2 px-4 text-center text-sm">
	<div class="container mx-auto">
		🚚
		<strong>FREE DELIVERY</strong>
		for orders above KSh 20,000 within Nairobi CBD •
		⚡
		<strong>Fast Delivery</strong>
		available •
		🔄
		<strong>Easy Returns</strong>
		on faulty goods.
	</div>
</div>
<!-- Enhanced Hero Section with Categories, Banner Slider, and Promotions -->
<section class="hero-gradient text-white pt-0 pb-4 md:py-8 relative overflow-hidden">
	<!-- Background Pattern -->
	<div class="absolute inset-0 opacity-10">
		<div class="pattern-dots pattern-blue-500 pattern-size-4 pattern-opacity-20"></div>
	</div>

	<div class="relative max-w-7xl mx-auto px-4">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mx-auto">

			<!-- Left Column: Categories Sidebar -->
			<div class="hidden lg:block lg:col-span-3">
				<div class="bg-white/10 backdrop-blur-sm rounded-xl p-4 lg:p-6">
					<h3 class="text-lg lg:text-xl font-bold mb-4 flex items-center">
						<i class="fas fa-list mr-2"></i>
						Categories
					</h3>

					<nav class="space-y-2">
						{% for category in categories|slice(0,9) %}
						<a href="/category/{{ category.slug }}" class="category-sidebar-item group">
							<div class="category-sidebar-icon">
								<i class="fas {{ category.icon|default('fa-tag') }}"></i>
							</div>
							<span class="category-sidebar-name">{{ category.name }}</span>
							<div class="category-sidebar-arrow">
								<i class="fas fa-chevron-right"></i>
							</div>
						</a>
						{% else %}
						<!-- Fallback categories -->
						{% for cat in [
						{name: 'Phones & Tablets', slug: 'phones-tablets', icon: 'fa-mobile-alt'},
						{name: 'Electronics', slug: 'electronics', icon: 'fa-tv'},
						{name: 'Fashion', slug: 'fashion', icon: 'fa-tshirt'},
						{name: 'Home & Office', slug: 'home-office', icon: 'fa-home'},
						{name: 'Beauty & Health', slug: 'beauty-health', icon: 'fa-spa'},
						{name: 'Supermarket', slug: 'supermarket', icon: 'fa-shopping-cart'},
						{name: 'Computing', slug: 'computing', icon: 'fa-laptop'},
						{name: 'Baby & Toys', slug: 'baby-toys', icon: 'fa-baby'},
						{name: 'Gaming', slug: 'gaming', icon: 'fa-gamepad'}
						] %}
						<a href="/category/{{ cat.slug }}" class="category-sidebar-item group">
							<div class="category-sidebar-icon">
								<i class="fas {{ cat.icon }}"></i>
							</div>
							<span class="category-sidebar-name">{{ cat.name }}</span>
							<div class="category-sidebar-arrow">
								<i class="fas fa-chevron-right"></i>
							</div>
						</a>
						{% endfor %}
						{% endfor %}

						<!-- View All Categories -->
						<a href="/categories" class="category-sidebar-item group bg-white/20 mt-4 rounded-lg">
							<div class="category-sidebar-icon">
								<i class="fas fa-th-large"></i>
							</div>
							<span class="category-sidebar-name">View All Categories</span>
							<div class="category-sidebar-arrow">
								<i class="fas fa-arrow-right"></i>
							</div>
						</a>
					</nav>
				</div>
			</div>

			<!-- Middle Column: Main Banner Slider -->
			<div class="lg:col-span-6">
				<div class="bg-white/10 backdrop-blur-sm sm:rounded-xl p-4">
					<div class="hero-carousel-desktop">
						{% for slide in hero_slides %}
						<div class="hero-slide-desktop {% if loop.first %}active{% endif %}"
							data-slide="{{ loop.index0 }}">
							<a href="{{ slide.link }}">
								<div class="relative  overflow-hidden">
									<img src="{{ slide.image }}" alt="{{ slide.alt }}"
										class="w-full h-64 md:h-98 object-cover p-2 sm:p-0 sm:rounded-xl">

									<!-- Caption Overlay -->
									<div
										class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent p-6">
										<div
											class="inline-block bg-yellow-400 text-gray-800 px-3 py-1 rounded-full text-sm font-bold mb-2">
											{{ slide.badge_text }}
										</div>
										<h2 class="text-xl md:text-2xl lg:text-3xl font-bold mb-2">
											{{ slide.caption_title|raw }}
										</h2>
										<p class="text-sm md:text-base opacity-90">{{ slide.caption_description }}</p>

										{% if slide.offer_ending %}
										<div
											class="mt-3 bg-red-500 text-white px-3 py-1 rounded-lg font-bold inline-flex items-center text-sm">
											<i class="fas fa-clock mr-2"></i>
											Ends:
											{{ slide.offer_ending }}
										</div>
										{% endif %}
									</div>

									<!-- Floating Store Badge -->
									<div
										class="absolute top-4 right-4 bg-yellow-400 text-gray-800 p-2 rounded-xl shadow-lg">
										<div class="font-bold text-sm">📍 Ngara Store</div>
										<div class="text-xs">Open Mon-Sat: 8AM-8PM</div>
									</div>
								</div>
							</a>
						</div>
						{% endfor %}
					</div>

					<!-- Carousel Controls -->
					<div class="hidden sm:flex justify-center mt-4 space-x-4">
						<button
							class="hero-prev bg-white/20 w-8 h-8 rounded-full flex items-center justify-center hover:bg-white/30 transition duration-300">
							<i class="fas fa-chevron-left"></i>
						</button>
						<div class="flex space-x-2">
							{% for slide in hero_slides %}
							<button
								class="hero-indicator-desktop w-3 h-3 rounded-full bg-white/30 {% if loop.first %}bg-white/100{% endif %}"
								data-slide="{{ loop.index0 }}"></button>
							{% endfor %}
						</div>
						<button
							class="hero-next bg-white/20 w-8 h-8 rounded-full flex items-center justify-center hover:bg-white/30 transition duration-300">
							<i class="fas fa-chevron-right"></i>
						</button>
					</div>
				</div>

				<!-- Mobile Hero (Hidden on Desktop) -->
				<div class="md:hidden mt-4">
					<div class="hero-carousel-mobile">
						{% for slide in hero_slides %}
						<div class="hero-slide-mobile px-1 {% if loop.first %}active{% endif %}"
							data-slide="{{ loop.index0 }}">
							<a href="{{ slide.link }}">
								<div class="bg-white shadow-lg overflow-hidden">
									<img src="{{ slide.image }}" alt="{{ slide.alt }}" class="w-full h-48 object-cover">

									<div class="p-4">
										<div
											class="inline-block bg-yellow-400 text-gray-800 px-3 py-1 text-sm font-bold mb-2">
											{{ slide.badge_text }}
										</div>
										<h3 class="text-lg font-bold mb-1">{{ slide.caption_title|raw }}</h3>
										<p class="text-sm text-gray-600 mb-2">{{ slide.caption_description }}</p>

										{% if slide.offer_ending %}
										<div
											class="bg-red-500 text-white px-3 py-1 rounded-lg text-sm font-bold inline-flex items-center">
											<i class="fas fa-clock mr-2"></i>
											Ends:
											{{ slide.offer_ending }}
										</div>
										{% endif %}
									</div>
								</div>
							</a>
						</div>
						{% endfor %}
					</div>

					<!-- Mobile Indicators -->
					<div class="flex justify-center mt-4 space-x-2">
						{% for slide in hero_slides %}
						<button
							class="hero-indicator-mobile w-2 h-2 rounded-full bg-white/30 {% if loop.first %}bg-white/100{% endif %}"
							data-slide="{{ loop.index0 }}"></button>
						{% endfor %}
					</div>
				</div>
			</div>

			<!-- Right Column: Promotions Sidebar -->
			<div class="hidden lg:block lg:col-span-3 grid grid-cols-2 sm:grid-cols-1 gap-2 px-1">

				<!-- Top Deals -->
				<div class="bg-gradient-to-br from-green-500 to-teal-500 rounded-xl p-2 sm:p-4">
					<div class="flex items-center mb-3">
						<div class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center mr-3">
							<i class="fas fa-fire text-white"></i>
						</div>
						<div>
							<h4 class="font-bold text-lg">Top Deals</h4>
							<p class="text-sm opacity-90">Best Sellers</p>
						</div>
					</div>

					<div class="space-y-3">
						{% for product in top_products|slice(0,5) %}
						<a href="/products/{{ product.slug }}" class="top-deal-item group">
							<div class="top-deal-image">
								<img src="{{ product.images[0]|default('https://images.unsplash.com/photo-1505740420928-5e560c06d30e?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80') }}"
									alt="{{ product.name }}" class="w-full h-16 object-cover rounded">
							</div>
							<div class="top-deal-info">
								<h5 class="text-[10px] sm:text-md">{{ product.name|slice(0,30) }}
									{% if product.name|length > 30 %}...
									{% endif %}
								</h5>
								<div class="top-deal-price">
									<span class="font-bold">KSh
										{{ product.final_price|number_format }}</span>
									{% if product.discount_percentage > 0 %}
									<span class="text-xs line-through opacity-75">KSh
										{{ product.price|number_format }}</span>
									{% endif %}
								</div>
							</div>
						</a>
						{% else %}
						{% endfor %}
					</div>

					<a href="/deals"
						class="block text-center hidden sm:block text-[11px] sm:text-md mt-3 bg-white/20 font-semibold sm:font-bold py-1 sm:py-2 rounded-md hover:bg-white/30 transition duration-200">
						View All Deals →
					</a>
				</div>
			</div>
		</div>
	</div>
</section>

<!-- Flash Sale Section -->
{% if flash_offers|length %}
<section class="max-w-6xl mx-auto bg-gradient-to-r from-red-50 to-orange-50 border-t border-b border-red-200">
	<div class="container mx-auto">
		<!-- Header -->
		<div class="bg-gradient-to-r from-red-600 to-orange-600 px-3 sm:px-6 py-3">
			<div class="flex justify-between items-center">
				<div class="flex-row sm:flex items-center space-x-4">
					<div class="flex items-center space-x-2">
						<i class="fas fa-bolt text-xl animate-pulse"></i>
						<div>
							<h2 class="text-[12px] sm:text-xl">FLASH SALE</h2>
							<div class="text-[10px] sm:text-sm font-normal opacity-90">Limited Time Offers</div>
						</div>
					</div>

					<!-- timelapse counter -->
					<div
						class="flash-countdown flex items-center gap-1 sm:gap-3 text-white mt-2 sm:mt-0 text-[10px] sm:text-base">

						<!-- Days -->
						<div class="flex items-center gap-1">
							<div id="d1"
								class="w-6 h-8 sm:w-10 sm:h-12 flex items-center justify-center bg-black rounded text-lg sm:text-2xl font-bold shadow">
								0</div>
							<div id="d2"
								class="w-6 h-8 sm:w-10 sm:h-12 flex items-center justify-center bg-black rounded text-lg sm:text-2xl font-bold shadow">
								0</div>
							<div
								class="w-14 h-8 sm:w-20 sm:h-12 flex items-center justify-center bg-black rounded text-lg sm:text-2xl font-bold shadow">
								DAYS
							</div>
						</div>


						<!-- Hours -->
						<div class="flex items-center gap-1">
							<div id="h1"
								class="w-6 h-8 sm:w-10 sm:h-12 flex items-center justify-center bg-black rounded text-lg sm:text-3xl font-bold shadow">
								0</div>
							<div id="h2"
								class="w-6 h-8 sm:w-10 sm:h-12 flex items-center justify-center bg-black rounded text-lg sm:text-3xl font-bold shadow">
								0</div>
						</div>

						<div class="text-xs sm:text-2xl font-bold">:</div>

						<!-- Minutes -->
						<div class="flex items-center gap-1">
							<div id="m1"
								class="w-6 h-8 sm:w-10 sm:h-12 flex items-center justify-center bg-black rounded text-lg sm:text-3xl font-bold shadow">
								0</div>
							<div id="m2"
								class="w-6 h-8 sm:w-10 sm:h-12 flex items-center justify-center bg-black rounded text-lg sm:text-3xl font-bold shadow">
								0</div>
						</div>

						<div class="text-xs sm:text-2xl font-bold">:</div>

						<!-- Seconds -->
						<div class="flex items-center gap-1">
							<div id="s1"
								class="w-6 h-8 sm:w-10 sm:h-12 flex items-center justify-center bg-black rounded text-lg sm:text-3xl font-bold shadow">
								0</div>
							<div id="s2"
								class="w-6 h-8 sm:w-10 sm:h-12 flex items-center justify-center bg-black rounded text-lg sm:text-3xl font-bold shadow">
								0</div>
						</div>

					</div>
				</div>
				<a href="/sales"
					class=" hidden sm:block text-white hover:text-pink-200 text-[12px] sm:text-md font-semibold sm:font-bold">
					View All
					<i class="fas fa-arrow-right ml-2"></i>
				</a>
			</div>
		</div>

		<!-- Flash Sale Products Grid -->
		<div class="py-2">
			<div class="flex gap-2 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-2 no-scrollbar">
				{% for product in flash_offers.products %}
				<div class="group flex-shrink-0 w-36 sm:w-48 snap-start">
					<a href="/products/{{product.slug}}">
						<div class="relative">
							{% if product.images and product.images|length > 0 %}
							<img src="{{ product.images[0] }}" alt="{{ product.name }}"
								class="w-full  h-32 sm:h-40 object-cover">
							{% else %}
							<img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80"
								alt="{{ product.name }}" class="w-full  h-32 sm:h-40 object-cover">
							{% endif %}

							<!-- Flash Sale Badge -->
							<div class="absolute top-3 left-3">
								<div
									class="bg-red-500 text-white px-3 py-1 rounded-full text-[10px] sm:text-xs font-bold animate-pulse">
									⚡ FLASH SALE
								</div>
							</div>

							{% if product.discount_percentage > 0 %}
							<div
								class="absolute top-3 right-3 bg-yellow-400 text-gray-900 px-2 py-1 rounded-lg text-[10px] sm:text-sm font-bold">
								-{{ product.discount_percentage|round }}%
							</div>
							{% endif %}

							<!-- Overlay on hover -->
							<div
								class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
							</div>
						</div>
					</a>

					<div class="pt-2 sm:p-1">
						<h3
							class="text-[12px] min-h-9 sm:min-h-10 sm:text-md font-semibold sm:font-bold text-gray-900 line-clamp-2">
							{{ product.name }}</h3>

						<!-- Price -->
						<div class="mb-1">
							<div class="flex items-center space-x-2">
								<span class="text-xs sm:text-xl font-black text-red-600">KSh
									{{ product.pivot.sale_price|number_format }}</span>
								{# {% if product.has_active_offers %} #}
								<span class="text-[10px] sm:text-sm text-gray-500 line-through">KSh
									{{ product.price|number_format }}</span>
								{# {% endif %} #}
							</div>
						</div>

						<!-- Stock Progress -->
						{% set stock_percentage = (product.pivot.quantity - (product.pivot.sold +1) )/
						product.pivot.quantity * 100 %}
						<div class="mb-2 sm:mb-2">
							<div class="flex justify-between text-xs mb-1">
								<span class="text-gray-600">{{ product.pivot.quantity - (product.pivot.sold ) }}
									items left</span>
							</div>
							<div class="w-full bg-gray-200 rounded-full h-2">
								<div class="bg-gradient-to-r from-red-500 to-orange-500 h-2 rounded-full"
									style="width: {{ stock_percentage }}%"></div>
							</div>
						</div>
					</div>
				</div>
				{% endfor %}
			</div>
			<a href="/sales"
				class="sm:hidden text-xs text-red-600 font-bold hover:text-red-800 transition duration-200 flex items-center space-x-2 px-4 py-2 hover:border-red-400">
				<span>View All Deals</span>
				<i class="fas fa-arrow-right"></i>
			</a>
		</div>
	</div>
</section>
{% endif %}

<!-- Categories Menu Bar -->
<div class="space-y-3">
	<!-- All Categories -->
	<div
		class="max-w-6xl mx-auto my-4 bg-white dark:bg-gray-800 sm:rounded-xl shadow-sm border border-gray-200 dark:border-gray-700">
		<div class="p-1 sm:p-4">
			<div class="grid grid-cols-6 md:grid-cols-6 space-y-3">
				{% for category in categories %}
				<a href="/category/{{ category.slug }}">
					<div class="flex-row items-center justify-center p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">
						<div class="flex items-center justify-center">
							{% if category.image_url %}
							<img src="{{ category.image_url }}" alt="{{ category.name }}"
								class="w-10 h-10 rounded-lg object-cover">
							{% else %}
							<div
								class="w-10 h-10 bg-blue-100 dark:bg-blue-900 rounded-lg flex items-center justify-center">
								<i class="fas fa-mobile-alt text-blue-600 dark:text-blue-400"></i>
							</div>
							{% endif %}
						</div>
						<div class="hidden sm:flex items-center justify-center mt-2">
							<h4 class="text-xs font-medium text-gray-900 dark:text-white">{{ category.name }}</h4>
						</div>
					</div>
				</a>
				{% endfor %}
			</div>
		</div>
	</div>
</div>

<!-- Category Showcases Section -->
<section class="max-w-6xl mx-auto  pb-12 pt-2 sm:pt-6 bg-gray-50">
	<div class="container mx-auto">

		<!-- Toys & Dolls -->
		{% if toys_and_dolls|length %}
		<div class="mb-4 sm:mb-8 bg-white  shadow-lg overflow-hidden">
			<div class="bg-gradient-to-r from-blue-600 to-purple-600 px-2 sm:px-6 py-1 sm:py-3">
				<div class="flex justify-between items-center">
					<div class="flex items-center space-x-4">
						<div class="bg-white/20 p-2 sm:p-3 rounded-xl">
							<i class="fas fa-tshirt text-lg sm:text-2xl text-white"></i>
						</div>
						<div>
							<h3 class="text-xs sm:text-2xl font-bold text-white">Toys & Dolls</h3>
							<p class="text-[10px] sm:text-md text-pink-100">Teddy bears, DIY boards & more</p>
						</div>
					</div>
					<a href="/category/electronics"
						class="text-white hover:text-pink-200 text-[10px] sm:text-md font-semibold sm:font-bold">
						View All
						<i class="fas fa-arrow-right ml-2"></i>
					</a>
				</div>
			</div>
			<div class="p-2">
				<div class="flex gap-2 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-2 no-scrollbar">

					{% if toys_and_dolls|length %}
					{% for product in toys_and_dolls|slice(0,8) %}
					<div class="group flex-shrink-0 w-36 sm:w-48 snap-start">
						<a href="/products/{{ product.slug }}">
							<div class="relative overflow-hidden bg-gray-100 mb-3">
								<img src="{{ product.images[0] }}" alt="{{ product.name }}"
									class="w-full h-32 sm:h-40 object-cover">
							</div>

							<h4
								class="text-[12px] min-h-[36px] sm:min-h-[16px] sm:text-md font-semibold sm:font-bold text-gray-900 mb-1 line-clamp-2">
								{{ product.name }}
							</h4>
						</a>

						<div class="flex items-center justify-between">
							<span class="text-orange-600 text-[10px] sm:text-md font-semibold sm:font-bold">
								KSh
								{{ product.price|number_format }}
							</span>

						</div>
					</div>
					{% endfor %}
					{% endif %}

				</div>

			</div>
		</div>
		{% endif %}

		<!-- Fashion -->
		{% if fashion|length %}
		<div class="mb-4 sm:mb-8 bg-white  shadow-lg overflow-hidden">
			<div class="bg-gradient-to-r from-blue-600 to-purple-600 px-2 sm:px-6 py-1 sm:py-3">
				<div class="flex justify-between items-center">
					<div class="flex items-center space-x-4">
						<div class="bg-white/20 p-2 sm:p-3 rounded-xl">
							<i class="fas fa-tshirt text-lg sm:text-2xl text-white"></i>
						</div>
						<div>
							<h3 class="text-xs sm:text-2xl font-bold text-white">Fashion</h3>
							<p class="text-[10px] sm:text-md text-pink-100">Trending outfits, designers & officials</p>
						</div>
					</div>
					<a href="/category/fashion"
						class="text-white hover:text-pink-200 text-[10px] sm:text-md font-semibold sm:font-bold">
						View All
						<i class="fas fa-arrow-right ml-2"></i>
					</a>
				</div>
			</div>
			<div class="p-2">
				<div class="flex gap-2 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-2 no-scrollbar">

					{% if fashion|length %}
					{% for product in fashion|slice(0,8) %}
					<div class="group flex-shrink-0 w-36 sm:w-48 snap-start">
						<a href="/products/{{ product.slug }}">
							<div class="relative overflow-hidden bg-gray-100 mb-3">
								<img src="{{ product.images[0] }}" alt="{{ product.name }}"
									class="w-full h-32 sm:h-40 object-cover">
							</div>

							<h4
								class="text-[12px] min-h-[36px] sm:min-h-[16px] sm:text-md font-semibold sm:font-bold text-gray-900 mb-1 line-clamp-2">
								{{ product.name }}
							</h4>
						</a>

						<div class="flex items-center justify-between">
							<span class="text-orange-600 text-[10px] sm:text-md font-semibold sm:font-bold">
								KSh
								{{ product.price|number_format }}
							</span>

						</div>
					</div>
					{% endfor %}
					{% endif %}

				</div>

			</div>
		</div>
