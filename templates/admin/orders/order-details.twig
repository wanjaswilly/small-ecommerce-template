{% extends "admin.twig" %}

{% block content %}
<div class="min-h-screen bg-gray-50 py-6">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-6">
            <a href="/admin/orders" class="inline-flex items-center text-blue-600 hover:text-blue-500 mb-4">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                Back to Orders
            </a>
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <h1 class="text-2xl font-bold text-gray-900">Order #{{ order.order_number }}</h1>
                    <p class="mt-2 text-gray-600">Placed on {{ order.created_at|date('F d, Y \\a\\t g:i A') }}</p>
                </div>
                <div class="mt-4 sm:mt-0">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-{{ status_labels[order.status].color }}-100 text-{{ status_labels[order.status].color }}-800">
                        {{ status_labels[order.status].label }}
                    </span>
                </div>
            </div>
        </div>

        <div class="space-y-6">
            <!-- Order Status Timeline -->
            <div class="bg-white shadow rounded-lg p-6">
                <h2 class="text-lg font-medium text-gray-900 mb-4">Order Status</h2>
                <div class="space-y-4">
                    <div class="flex items-center">
                        <div class="flex-shrink-0 w-8 h-8 rounded-full bg-green-600 flex items-center justify-center">
                            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                        </div>
                        <div class="ml-4">
                            <p class="text-sm font-medium text-gray-900">Order Placed</p>
                            <p class="text-sm text-gray-600">{{ order.created_at|date('M d, Y g:i A') }}</p>
                        </div>
                    </div>
                    
                    {% if order.status in ['processing', 'ready_for_dispatch', 'dispatched', 'out_for_delivery', 'delivered'] %}
                    <div class="flex items-center">
                        <div class="flex-shrink-0 w-8 h-8 rounded-full {% if order.processing_started_at %}bg-green-600{% else %}bg-gray-300{% endif %} flex items-center justify-center">
                            {% if order.processing_started_at %}
                            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            {% endif %}
                        </div>
                        <div class="ml-4">
                            <p class="text-sm font-medium text-gray-900">Processing</p>
                            {% if order.processing_started_at %}
                            <p class="text-sm text-gray-600">Started {{ order.processing_started_at|date('M d, Y') }}</p>
                            {% endif %}
                        </div>
                    </div>
                    {% endif %}
                    
                    {% if order.status in ['ready_for_dispatch', 'dispatched', 'out_for_delivery', 'delivered'] %}
                    <div class="flex items-center">
                        <div class="flex-shrink-0 w-8 h-8 rounded-full {% if order.processed_at %}bg-green-600{% else %}bg-gray-300{% endif %} flex items-center justify-center">
                            {% if order.processed_at %}
                            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            {% endif %}
                        </div>
                        <div class="ml-4">
                            <p class="text-sm font-medium text-gray-900">Ready for Dispatch</p>
                            {% if order.processed_at %}
                            <p class="text-sm text-gray-600">Completed {{ order.processed_at|date('M d, Y') }}</p>
                            {% endif %}
                        </div>
                    </div>
                    {% endif %}
                    
                    {% if estimated_delivery %}
                    <div class="flex items-center">
                        <div class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center">
                            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <div class="ml-4">
                            <p class="text-sm font-medium text-gray-900">Estimated Delivery</p>
                            <p class="text-sm text-gray-600">{{ estimated_delivery }}</p>
                        </div>
                    </div>
                    {% endif %}
                </div>
            </div>

            <!-- Order Items -->
            <div class="bg-white shadow rounded-lg p-6">
                <h2 class="text-lg font-medium text-gray-900 mb-4">Order Items</h2>
                <div class="space-y-4">
                    {% for item in order.items %}
                    <div class="flex items-start space-x-4">
                        <div class="flex-shrink-0 w-16 h-16 bg-gray-200 rounded-md overflow-hidden">
                            {% if item.product.images|first %}
                            <img src="{{ item.product.images|first }}" alt="{{ item.product.name }}" class="w-full h-full object-cover">
                            {% else %}
                            <div class="w-full h-full flex items-center justify-center text-gray-400">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                            </div>
                            {% endif %}
                        </div>
                        <div class="flex-1">
                            <h3 class="text-sm font-medium text-gray-900">{{ item.product.name }}</h3>
                            {% if item.product.car_part %}
                            <p class="text-sm text-gray-600 mt-1">
                                {{ item.product.car_part.car_brand }} {{ item.product.car_part.car_model }} - {{ item.product.car_part.part_type }}
                            </p>
                            {% endif %}
                            <div class="mt-2 flex items-center justify-between">
                                <p class="text-sm text-gray-600">Quantity: {{ item.quantity }}</p>
                                <p class="text-sm font-medium text-gray-900">KES {{ item.price|number_format(2) }}</p>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>

            <!-- Order Summary -->
            <div class="bg-white shadow rounded-lg p-6">
                <h2 class="text-lg font-medium text-gray-900 mb-4">Order Summary</h2>
                <div class="space-y-3">
                    <div class="flex justify-between">
                        <span class="text-gray-600">Subtotal</span>
                        <span class="font-medium">KES {{ order.subtotal|number_format(2) }}</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-600">Delivery Fee</span>
                        <span class="font-medium">KES {{ order.delivery_fee|number_format(2) }}</span>
                    </div>
                    <div class="border-t pt-3 flex justify-between">
                        <span class="text-lg font-bold text-gray-900">Total</span>
                        <span class="text-lg font-bold text-gray-900">KES {{ order.total_amount|number_format(2) }}</span>
                    </div>
                </div>
            </div>

            <!-- Delivery Information -->
            <div class="bg-white shadow rounded-lg p-6">
                <h2 class="text-lg font-medium text-gray-900 mb-4">Delivery Information</h2>
                <div class="space-y-2">
                    <div>
                        <span class="text-sm font-medium text-gray-600">Delivery Location:</span>
                        <p class="text-sm text-gray-900">{{ order.delivery_location }}</p>
                    </div>
                    {% if order.specific_address %}
                    <div>
                        <span class="text-sm font-medium text-gray-600">Specific Address:</span>
                        <p class="text-sm text-gray-900">{{ order.specific_address }}</p>
                    </div>
                    {% endif %}
                    {% if order.tracking_number %}
                    <div>
                        <span class="text-sm font-medium text-gray-600">Tracking Number:</span>
                        <p class="text-sm text-gray-900 font-mono">{{ order.tracking_number }}</p>
                    </div>
                    {% endif %}
                </div>
            </div>

            <!-- Payment Information -->
            <div class="bg-white shadow rounded-lg p-6">
                <h2 class="text-lg font-medium text-gray-900 mb-4">Payment Information</h2>
                <div class="space-y-2">
                    <div>
                        <span class="text-sm font-medium text-gray-600">Payment Method:</span>
                        <p class="text-sm text-gray-900 capitalize">{{ order.payment_method|replace({'_': ' '}) }}</p>
                    </div>
                    <div>
                        <span class="text-sm font-medium text-gray-600">Payment Status:</span>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-{{ payment_status_labels[order.payment_status].color }}-100 text-{{ payment_status_labels[order.payment_status].color }}-800">
                            {{ payment_status_labels[order.payment_status].label }}
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}